# SPDX-License-Identifier: AGPL-3.0-only
# The AprsMap gateway as a system service (docs/features/F1.37-gateway-service.md, behavior 5): the station, the
# published web app and the admin web app, configured in /etc/aprsmap/gateway.toml. Installed by install.sh.
[Unit]
Description=AprsMap gateway: APRS station and web app
Documentation=https://github.com/APRS-NET/AprsMap/blob/main/docs/deployment.md
Wants=network-online.target
After=network-online.target gpsd.service

[Service]
Type=simple
User=aprsmap
Group=aprsmap
# The TNC on USB: serial ports belong to the dialout group on Ubuntu.
SupplementaryGroups=dialout
ExecStart=/opt/aprsmap-gateway/aprsmap-gateway --config /etc/aprsmap/gateway.toml
WorkingDirectory=/opt/aprsmap-gateway
# /var/lib/aprsmap (settings, history, tiles) and /etc/aprsmap (the TOML file), owned by the service's user.
StateDirectory=aprsmap
ConfigurationDirectory=aprsmap
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=DOTNET_NOLOGO=1
Restart=on-failure
RestartSec=5
# Hardening that still lets it reach serial ports and the network.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target

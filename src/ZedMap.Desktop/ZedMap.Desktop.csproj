<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Help › About lists the components this app is built from (F1.34). -->
    <ZedMapEmbedComponents>true</ZedMapEmbedComponents>
    <ZedMapComponentHost>Desktop</ZedMapComponentHost>
    <OutputType>WinExe</OutputType>
    <ZedMapUsesAvalonia>true</ZedMapUsesAvalonia>
    <AssemblyName>$(ProductSlug)</AssemblyName>
    <!-- The executable's icon on Windows; generated from build/branding/icon.svg by tools/make-icons.sh. -->
    <ApplicationIcon>../../build/branding/icon.ico</ApplicationIcon>
    <Description>The standalone desktop app (Windows, Linux, macOS). Runs the engine in-process, or shows a gateway's as its client.</Description>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../ZedMap.UI/ZedMap.UI.csproj" />
    <ProjectReference Include="../ZedMap.Hosting/ZedMap.Hosting.csproj" />
    <!-- The web viewer (F1.35): the gateway's server parts, run around the desktop's own engine. -->
    <ProjectReference Include="../ZedMap.Server/ZedMap.Server.csproj" />
    <!-- A gateway's client (F1.39): its hub, as the browser app reaches it. -->
    <ProjectReference Include="../ZedMap.Client.Remote/ZedMap.Client.Remote.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Velopack" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- The applications menu's icon for an installed AppImage (LinuxDesktopEntry). -->
    <EmbeddedResource Include="../../build/branding/icon-256.png" LogicalName="icon-256.png" />
  </ItemGroup>
</Project>

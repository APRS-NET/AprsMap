<!-- The Packets panel (F1.8): filters, pause and save above the live packet list, newest first. Its DataContext is the
     main view model; everything inside works on its packet list. -->
<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:AprsMap.UI.ViewModels"
  xmlns:p="using:AprsMap.UI.Packets"
  xmlns:l="using:AprsMap.UI.Localization"
  x:Class="AprsMap.UI.Views.PacketsPanel"
  x:DataType="vm:MainViewModel"
>
  <UserControl.Styles>
    <!-- A duplicate is listed in the muted style (F1.8 behavior 2). -->
    <Style Selector="TextBlock.duplicate">
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
    </Style>
  </UserControl.Styles>
  <DockPanel DataContext="{Binding PacketList}" x:DataType="p:PacketListViewModel">
    <!-- Wraps onto more lines when the panel is narrow or the text is large. -->
    <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" ItemSpacing="8" LineSpacing="6" Margin="8,6">
      <TextBox
        x:Name="SearchBox"
        Text="{Binding FilterText}"
        PlaceholderText="{l:T Packets.Search}"
        AutomationProperties.Name="{l:T Packets.Search}"
        MinWidth="180"
      />
      <TextBox
        x:Name="StationBox"
        Text="{Binding Station}"
        PlaceholderText="{l:T Packets.Station}"
        AutomationProperties.Name="{l:T Packets.Station}"
        FontFamily="{DynamicResource Font.Mono}"
        MinWidth="120"
      />
      <ComboBox
        x:Name="KindBox"
        ItemsSource="{Binding Kinds}"
        SelectedItem="{Binding SelectedKind}"
        AutomationProperties.Name="{l:T Packets.Type}"
        ToolTip.Tip="{l:T Packets.Type}"
      >
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="p:PacketListViewModel+KindOption">
            <TextBlock Text="{Binding Name}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <ComboBox
        x:Name="SourceBox"
        ItemsSource="{Binding Sources}"
        SelectedItem="{Binding SelectedSource}"
        IsVisible="{Binding HasSources}"
        AutomationProperties.Name="{l:T Packets.Source}"
        ToolTip.Tip="{l:T Packets.Source}"
      >
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="p:PacketListViewModel+SourceOption">
            <TextBlock Text="{Binding Name}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <ToggleButton x:Name="IssuesOnlyButton" IsChecked="{Binding IssuesOnly}" Content="{l:T Packets.IssuesOnly}" />
      <ToggleButton x:Name="ShowRawButton" IsChecked="{Binding ShowRaw}" Content="{l:T Packets.ShowRaw}" />
      <Button
        x:Name="ClearFiltersButton"
        Command="{Binding ClearFiltersCommand}"
        Content="{l:T Packets.ClearFilters}"
        IsVisible="{Binding IsFiltered}"
      />
      <Button
        x:Name="PauseButton"
        Command="{Binding TogglePauseCommand}"
        Content="{Binding PauseText}"
        Classes.accent="{Binding IsPaused}"
      />
      <!-- Save offers a menu of formats (F1.8 behavior 10), filled in code from the exporters. -->
      <Button x:Name="SaveButton" Content="{l:T Packets.Save}">
        <Button.Flyout>
          <MenuFlyout Placement="BottomEdgeAlignedLeft" />
        </Button.Flyout>
      </Button>
    </WrapPanel>
    <TextBlock
      DockPanel.Dock="Top"
      Text="{Binding Notice}"
      IsVisible="{Binding Notice, Converter={x:Static ObjectConverters.IsNotNull}}"
      Foreground="{DynamicResource Brush.Warn}"
      TextWrapping="Wrap"
      Margin="8,0,8,6"
    />
    <Panel>
      <ListBox
        x:Name="PacketList"
        ItemsSource="{Binding Rows}"
        SelectionMode="Multiple"
        Background="{DynamicResource Brush.Surface}"
        Grid.IsSharedSizeScope="True"
      >
        <ListBox.ContextMenu>
          <ContextMenu>
            <MenuItem x:Name="CopyItem" Header="{l:T Packets.Copy}" InputGesture="Ctrl+C" />
            <MenuItem x:Name="OnlyStationItem" Header="{l:T Packets.OnlyStation}" />
          </ContextMenu>
        </ListBox.ContextMenu>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="p:PacketRow">
            <!-- The time and callsign columns fit their longest text, the same in every row, at any text size. -->
            <Grid RowDefinitions="Auto,Auto,Auto">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="Time" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="Markers" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="Source" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <ToggleButton
                IsChecked="{Binding IsExpanded}"
                ToolTip.Tip="{l:T Packets.Expand}"
                AutomationProperties.Name="{l:T Packets.Expand}"
                VerticalAlignment="Center"
                Background="{x:Null}"
                BorderThickness="0"
                Padding="2"
                Margin="0,0,6,0"
              >
                <PathIcon
                  Data="M 8.6,4.6 L 10,3.2 L 18.8,12 L 10,20.8 L 8.6,19.4 L 16,12 Z"
                  Width="{DynamicResource Icon.Size}"
                  Height="{DynamicResource Icon.Size}"
                />
              </ToggleButton>
              <TextBlock
                Grid.Column="1"
                Text="{Binding Time}"
                Foreground="{DynamicResource Brush.TextMuted}"
                FontFamily="{DynamicResource Font.Mono}"
                VerticalAlignment="Center"
                Margin="0,0,10,0"
              />
              <Image
                Grid.Column="2"
                Source="{Binding Symbol, Converter={x:Static p:SymbolIcons.Instance}}"
                AutomationProperties.Name="{Binding SymbolName}"
                ToolTip.Tip="{Binding SymbolName}"
                Width="{DynamicResource Icon.Size}"
                Height="{DynamicResource Icon.Size}"
                VerticalAlignment="Center"
                Margin="0,0,8,0"
              />
              <!-- Markers: a shape each, with a name for screen readers, never colour alone (F1.8 behaviors 2, 3, 5). -->
              <StackPanel
                Grid.Column="3"
                Orientation="Horizontal"
                Spacing="4"
                VerticalAlignment="Center"
                Margin="0,0,4,0"
              >
                <PathIcon
                  IsVisible="{Binding HasIssues}"
                  Data="M 12,2 L 23,21 L 1,21 Z M 11,8 L 13,8 L 13,15 L 11,15 Z M 11,17 L 13,17 L 13,19 L 11,19 Z"
                  Foreground="{DynamicResource Brush.Warn}"
                  Width="{DynamicResource Icon.Size}"
                  Height="{DynamicResource Icon.Size}"
                  ToolTip.Tip="{l:T Packets.HasIssues}"
                  AutomationProperties.Name="{l:T Packets.HasIssues}"
                  Focusable="False"
                />
                <!-- Doesn't fit its station's track (F1.20 behavior 4): a broken path, named in the tooltip. -->
                <PathIcon
                  IsVisible="{Binding HasAnomalies}"
                  Data="M 2,20 L 7,13 L 9,14.5 L 4,21.5 Z M 10,11 L 13,7 L 15,8.5 L 12,12.5 Z M 16,5 L 19,1 L 21,2.5 L 18,6.5 Z M 15,15 L 22,15 L 22,17 L 15,17 Z M 17.5,12.5 L 19.5,12.5 L 19.5,19.5 L 17.5,19.5 Z"
                  Foreground="{DynamicResource Brush.Warn}"
                  Width="{DynamicResource Icon.Size}"
                  Height="{DynamicResource Icon.Size}"
                  ToolTip.Tip="{Binding AnomalyText}"
                  AutomationProperties.Name="{Binding AnomalyText}"
                  Focusable="False"
                />
                <!-- Sent by this station (F2.1 behavior 13): an arrow leaving a box. -->
                <PathIcon
                  IsVisible="{Binding IsSent}"
                  Data="M 13,3 L 21,3 L 21,11 L 19,11 L 19,6.4 L 10.7,14.7 L 9.3,13.3 L 17.6,5 L 13,5 Z M 3,5 L 11,5 L 11,7 L 5,7 L 5,19 L 17,19 L 17,13 L 19,13 L 19,21 L 3,21 Z"
                  Foreground="{DynamicResource Brush.Accent}"
                  Width="{DynamicResource Icon.Size}"
                  Height="{DynamicResource Icon.Size}"
                  ToolTip.Tip="{l:T Packets.Sent}"
                  AutomationProperties.Name="{l:T Packets.Sent}"
                />
                <!-- Repeated by this station as a digipeater (F3.5 behavior 5): two arrows passing each other. -->
                <PathIcon
                  IsVisible="{Binding IsDigipeatedHere}"
                  Data="M 4,7 L 16,7 L 16,4 L 21,8.5 L 16,13 L 16,10 L 4,10 Z M 20,17 L 8,17 L 8,20 L 3,15.5 L 8,11 L 8,14 L 20,14 Z"
                  Foreground="{DynamicResource Brush.Accent}"
                  Width="{DynamicResource Icon.Size}"
                  Height="{DynamicResource Icon.Size}"
                  ToolTip.Tip="{l:T Packets.Marker.DigipeatedHere}"
                  AutomationProperties.Name="{l:T Packets.Marker.DigipeatedHere}"
                />
                <PathIcon
                  IsVisible="{Binding IsDirect}"
                  Data="F0 M 12,2 A 10,10 0 1 1 12,22 A 10,10 0 1 1 12,2 Z M 12,5 A 7,7 0 1 0 12,19 A 7,7 0 1 0 12,5 Z M 12,9 A 3,3 0 1 1 12,15 A 3,3 0 1 1 12,9 Z"
                  Foreground="{DynamicResource Brush.Accent}"
                  Width="{DynamicResource Icon.Size}"
                  Height="{DynamicResource Icon.Size}"
                  ToolTip.Tip="{Binding DirectText}"
                  AutomationProperties.Name="{Binding DirectText}"
                />
                <StackPanel
                  IsVisible="{Binding IsDigipeated}"
                  Orientation="Horizontal"
                  Spacing="1"
                  Background="Transparent"
                  ToolTip.Tip="{Binding DigipeatedText}"
                  AutomationProperties.Name="{Binding DigipeatedText}"
                >
                  <PathIcon
                    Data="M 2,19 L 8,7 L 14,15 L 19,5 L 16,5 L 16,3 L 22,3 L 22,9 L 20,9 L 20,7 L 14,19 L 8,11 L 4,20 Z"
                    Foreground="{DynamicResource Brush.Accent}"
                    Width="{DynamicResource Icon.Size}"
                    Height="{DynamicResource Icon.Size}"
                  />
                  <TextBlock
                    Text="{Binding HopsText}"
                    Foreground="{DynamicResource Brush.Accent}"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center"
                  />
                </StackPanel>
                <PathIcon
                  IsVisible="{Binding IsDuplicate}"
                  Data="F0 M 2,7 L 17,7 L 17,22 L 2,22 Z M 4,9 L 4,20 L 15,20 L 15,9 Z M 7,2 L 22,2 L 22,17 L 19,17 L 19,15 L 20,15 L 20,4 L 9,4 L 9,5 L 7,5 Z"
                  Foreground="{DynamicResource Brush.TextMuted}"
                  Width="{DynamicResource Icon.Size}"
                  Height="{DynamicResource Icon.Size}"
                  ToolTip.Tip="{l:T Packets.Duplicate}"
                  AutomationProperties.Name="{l:T Packets.Duplicate}"
                />
                <PathIcon
                  IsVisible="{Binding IsThirdParty}"
                  Data="M 2,2 L 22,2 L 22,22 L 2,22 Z M 4,4 L 4,20 L 20,20 L 20,4 Z M 8,8 L 16,8 L 16,16 L 8,16 Z"
                  Foreground="{DynamicResource Brush.Accent}"
                  Width="{DynamicResource Icon.Size}"
                  Height="{DynamicResource Icon.Size}"
                  ToolTip.Tip="{l:T Packets.ThirdParty}"
                  AutomationProperties.Name="{l:T Packets.ThirdParty}"
                />
              </StackPanel>
              <TextBlock
                Grid.Column="4"
                Text="{Binding Source}"
                Classes.duplicate="{Binding IsDuplicate}"
                FontFamily="{DynamicResource Font.Mono}"
                FontWeight="SemiBold"
                VerticalAlignment="Center"
                Margin="4,0,16,0"
              />
              <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <!-- Where it arrived, with several sources in use (F1.25 behavior 8). -->
                <TextBlock
                  Text="{Binding SourceText}"
                  IsVisible="{Binding SourceText, Converter={x:Static ObjectConverters.IsNotNull}}"
                  Foreground="{DynamicResource Brush.Accent}"
                />
                <TextBlock
                  Text="{Binding Summary}"
                  Classes.duplicate="{Binding IsDuplicate}"
                  TextTrimming="CharacterEllipsis"
                />
              </StackPanel>
              <!-- The raw text, with the part at fault marked. -->
              <p:RawText
                Grid.Row="1"
                Grid.Column="1"
                Grid.ColumnSpan="5"
                FontFamily="{DynamicResource Font.Mono}"
                TextWrapping="Wrap"
                Margin="0,4,0,0"
              >
                <p:RawText.IsVisible>
                  <MultiBinding Converter="{x:Static BoolConverters.Or}">
                    <Binding Path="IsExpanded" />
                    <Binding Path="$parent[ListBox].((p:PacketListViewModel)DataContext).ShowRaw" />
                  </MultiBinding>
                </p:RawText.IsVisible>
              </p:RawText>
              <ItemsControl
                Grid.Row="2"
                Grid.Column="1"
                Grid.ColumnSpan="5"
                ItemsSource="{Binding Issues}"
                IsVisible="{Binding IsExpanded}"
                Margin="0,4,0,0"
              >
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="p:PacketIssueRow">
                    <DockPanel>
                      <TextBlock
                        DockPanel.Dock="Left"
                        Text="{Binding Severity}"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource Brush.Warn}"
                        Margin="0,0,8,0"
                      />
                      <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                    </DockPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <TextBlock
        Text="{Binding EmptyText}"
        IsVisible="{Binding IsEmpty}"
        Foreground="{DynamicResource Brush.TextMuted}"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        TextWrapping="Wrap"
        Margin="16"
      />
    </Panel>
  </DockPanel>
</UserControl>

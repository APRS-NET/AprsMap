<!-- The GPS panel (F3.12): the active profile's GPS, its fix, accuracy, sky view and satellites. Its DataContext is the
     main view model; inside, its Gps. -->
<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:AprsMap.UI.ViewModels"
  xmlns:g="using:AprsMap.UI.Gps"
  xmlns:l="using:AprsMap.UI.Localization"
  x:Class="AprsMap.UI.Views.GpsPanel"
  x:DataType="vm:MainViewModel"
>
  <ScrollViewer
    DataContext="{Binding Gps}"
    x:DataType="g:GpsPanelViewModel"
    Background="{DynamicResource Brush.Surface}"
  >
    <StackPanel Margin="12,10" Spacing="8">
      <TextBlock
        x:Name="NoGpsText"
        Text="{l:T Gps.None}"
        IsVisible="{Binding !HasGps}"
        Foreground="{DynamicResource Brush.TextMuted}"
        TextWrapping="Wrap"
      />
      <StackPanel x:Name="GpsDetails" Spacing="8" IsVisible="{Binding HasGps}" Grid.IsSharedSizeScope="True">
        <TextBlock x:Name="FixLabel" Text="{Binding FixText}" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock
          x:Name="GpsFromLabel"
          Text="{Binding FromText}"
          IsVisible="{Binding FromText, Converter={x:Static ObjectConverters.IsNotNull}}"
          Foreground="{DynamicResource Brush.TextMuted}"
          TextWrapping="Wrap"
        />
        <TextBlock
          Text="{Binding PositionText}"
          IsVisible="{Binding PositionText, Converter={x:Static ObjectConverters.IsNotNull}}"
        />
        <TextBlock
          Text="{Binding MotionText}"
          IsVisible="{Binding MotionText, Converter={x:Static ObjectConverters.IsNotNull}}"
          TextWrapping="Wrap"
        />
        <TextBlock
          Text="{Binding AgeText}"
          IsVisible="{Binding AgeText, Converter={x:Static ObjectConverters.IsNotNull}}"
          Foreground="{DynamicResource Brush.TextMuted}"
        />
        <TextBlock Text="{l:T Gps.Accuracy}" FontWeight="SemiBold" Margin="0,6,0,0" />
        <TextBlock
          x:Name="ErrorLabel"
          Text="{Binding ErrorText}"
          IsVisible="{Binding ErrorText, Converter={x:Static ObjectConverters.IsNotNull}}"
          TextWrapping="Wrap"
        />
        <TextBlock
          x:Name="DopLabel"
          Text="{Binding DopText}"
          IsVisible="{Binding DopText, Converter={x:Static ObjectConverters.IsNotNull}}"
          TextWrapping="Wrap"
        />
        <TextBlock
          Text="{Binding SatellitesText}"
          IsVisible="{Binding SatellitesText, Converter={x:Static ObjectConverters.IsNotNull}}"
          TextWrapping="Wrap"
        />
        <TextBlock
          Text="{l:T Gps.DopHint}"
          IsVisible="{Binding DopText, Converter={x:Static ObjectConverters.IsNotNull}}"
          Foreground="{DynamicResource Brush.TextMuted}"
          TextWrapping="Wrap"
        />
        <TextBlock Text="{l:T Gps.Sky}" FontWeight="SemiBold" Margin="0,6,0,0" />
        <g:SkyView
          x:Name="Sky"
          Satellites="{Binding Sky}"
          RingBrush="{DynamicResource Brush.Border}"
          LabelBrush="{DynamicResource Brush.TextMuted}"
          UsedBrush="{DynamicResource Brush.Accent}"
          TextBrush="{DynamicResource Brush.Text}"
          FontSize="{DynamicResource Text.Small}"
          Compass="{l:T Gps.Compass}"
          HorizontalAlignment="Left"
          AutomationProperties.Name="{l:T Gps.Sky}"
          AutomationProperties.HelpText="{l:T Gps.SkyHelp}"
        />
        <TextBlock Text="{l:T Gps.SkyHelp}" Foreground="{DynamicResource Brush.TextMuted}" TextWrapping="Wrap" />
        <TextBlock Text="{l:T Gps.Satellites}" FontWeight="SemiBold" Margin="0,6,0,0" />
        <!-- The table scrolls sideways on its own when the text is large, so the rest keeps wrapping. -->
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
          <StackPanel Spacing="4">
            <Grid ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="System" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="Id" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="Elevation" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="Azimuth" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="Signal" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock
                Grid.Column="0"
                Text="{l:T Gps.Column.System}"
                Foreground="{DynamicResource Brush.TextMuted}"
              />
              <TextBlock Grid.Column="1" Text="{l:T Gps.Column.Id}" Foreground="{DynamicResource Brush.TextMuted}" />
              <TextBlock
                Grid.Column="2"
                Text="{l:T Gps.Column.Elevation}"
                Foreground="{DynamicResource Brush.TextMuted}"
              />
              <TextBlock
                Grid.Column="3"
                Text="{l:T Gps.Column.Azimuth}"
                Foreground="{DynamicResource Brush.TextMuted}"
              />
              <TextBlock
                Grid.Column="4"
                Text="{l:T Gps.Column.Signal}"
                Foreground="{DynamicResource Brush.TextMuted}"
              />
              <TextBlock Grid.Column="5" Text="{l:T Gps.Column.Used}" Foreground="{DynamicResource Brush.TextMuted}" />
            </Grid>
            <ItemsControl x:Name="SatelliteList" ItemsSource="{Binding Satellites}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="g:GpsSatelliteRow">
                  <Grid ColumnSpacing="12" AutomationProperties.Name="{Binding Description}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" SharedSizeGroup="System" />
                      <ColumnDefinition Width="Auto" SharedSizeGroup="Id" />
                      <ColumnDefinition Width="Auto" SharedSizeGroup="Elevation" />
                      <ColumnDefinition Width="Auto" SharedSizeGroup="Azimuth" />
                      <ColumnDefinition Width="Auto" SharedSizeGroup="Signal" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding SystemText}" />
                    <TextBlock Grid.Column="1" Text="{Binding IdText}" />
                    <TextBlock Grid.Column="2" Text="{Binding ElevationText}" />
                    <TextBlock Grid.Column="3" Text="{Binding AzimuthText}" />
                    <TextBlock Grid.Column="4" Text="{Binding SignalText}" />
                    <TextBlock Grid.Column="5" Text="{Binding UsedText}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
        <Button
          x:Name="GpsConsoleButton"
          Content="{l:T Gps.OpenConsole}"
          Command="{Binding OpenConsoleCommand}"
          HorizontalAlignment="Left"
        />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>

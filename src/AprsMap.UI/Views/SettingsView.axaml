<!-- SPDX-License-Identifier: AGPL-3.0-only -->
<!-- The Settings page (docs/features/F0.6-appearance.md): a page over the main view, not a dialog. Sections down the
     side, or as tabs across the top on a narrow window; the options come from the settings registry. -->
<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:s="using:AprsMap.UI.Settings"
  xmlns:vm="using:AprsMap.UI.ViewModels"
  xmlns:p="using:AprsMap.UI.Packets"
  xmlns:sh="using:AprsMap.UI.Shell"
  xmlns:l="using:AprsMap.UI.Localization"
  x:Class="AprsMap.UI.Views.SettingsView"
  x:DataType="s:SettingsViewModel"
  Background="{DynamicResource Brush.Ground}"
  Foreground="{DynamicResource Brush.Text}"
  FontSize="{DynamicResource Text.Body}"
>
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding CloseCommand}" />
  </UserControl.KeyBindings>
  <UserControl.Styles>
    <!-- A device list check that failed (F4.16 behavior 9) reads in the warning colour. -->
    <Style Selector="TextBlock#ConnectionTestResult.warn">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Warn}" />
    </Style>
    <Style Selector="TextBlock#ConnectionStatus.warn">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Warn}" />
    </Style>
    <Style Selector="TextBlock#GatewayAccessMessage.warn">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Warn}" />
    </Style>
    <Style Selector="TextBlock#WebViewerStatus.warn">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Warn}" />
    </Style>
    <Style Selector="TextBlock#DeviceListChecked">
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
    </Style>
    <Style Selector="TextBlock#DeviceListChecked.warn">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Warn}" />
    </Style>
    <!-- Narrow windows: the sections become tabs across the top (set by code-behind). -->
    <Style Selector="ListBox#SectionList.narrow">
      <Setter Property="DockPanel.Dock" Value="Top" />
      <Setter Property="ItemsPanel">
        <ItemsPanelTemplate>
          <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </Setter>
    </Style>
  </UserControl.Styles>
  <DockPanel>
    <Border
      DockPanel.Dock="Top"
      Background="{DynamicResource Brush.Surface}"
      BorderBrush="{DynamicResource Brush.Border}"
      BorderThickness="{DynamicResource Thickness.BorderBottom}"
      Padding="16,10"
    >
      <StackPanel Orientation="Horizontal" Spacing="12">
        <Button
          x:Name="SettingsBackButton"
          Command="{Binding CloseCommand}"
          ToolTip.Tip="{l:T Settings.Back}"
          AutomationProperties.Name="{l:T Settings.Back}"
          VerticalAlignment="Center"
        >
          <PathIcon
            Data="M 10,2 L 12,4 L 6,10 L 22,10 L 22,14 L 6,14 L 12,20 L 10,22 L 0,12 Z"
            Width="{DynamicResource Icon.Size}"
            Height="{DynamicResource Icon.Size}"
          />
        </Button>
        <TextBlock
          x:Name="TitleLabel"
          Text="{Binding Title}"
          FontSize="{DynamicResource Text.Title}"
          FontWeight="SemiBold"
          VerticalAlignment="Center"
        />
      </StackPanel>
    </Border>

    <DockPanel>
      <ListBox
        x:Name="SectionList"
        DockPanel.Dock="Left"
        ItemsSource="{Binding Sections}"
        SelectedItem="{Binding SelectedSection}"
        Background="{DynamicResource Brush.Surface}"
        BorderBrush="{DynamicResource Brush.Border}"
        BorderThickness="{DynamicResource Thickness.Border}"
        MinWidth="180"
        AutomationProperties.Name="{Binding Title}"
      />

      <ScrollViewer x:Name="SectionScroll" Padding="24,16">
        <Panel MaxWidth="720" HorizontalAlignment="Left">
          <!-- Profiles (F0.8) -->
          <StackPanel x:Name="ProfilesSection" IsVisible="{Binding IsProfilesSection}" Spacing="12">
            <TextBlock
              x:Name="ProfilesReadOnlyNote"
              Text="{l:T Settings.Profiles.ReadOnly}"
              IsVisible="{Binding Profiles.IsReadOnly}"
              Foreground="{DynamicResource Brush.TextMuted}"
              TextWrapping="Wrap"
            />
            <ItemsControl x:Name="ProfileList" ItemsSource="{Binding Profiles.Rows}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="8" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="s:ProfileRow">
                  <Border
                    Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="{DynamicResource Thickness.Border}"
                    CornerRadius="{DynamicResource Radius.Control}"
                    Padding="12,8"
                  >
                    <StackPanel Spacing="6">
                      <WrapPanel ItemSpacing="10">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock
                          Text="{Binding ActiveText}"
                          IsVisible="{Binding IsActive}"
                          Foreground="{DynamicResource Brush.Accent}"
                          FontWeight="SemiBold"
                        />
                      </WrapPanel>
                      <WrapPanel ItemSpacing="10">
                        <TextBlock Text="{Binding Callsign}" FontFamily="{DynamicResource Font.Mono}" />
                        <TextBlock Text="{Binding ServerText}" Foreground="{DynamicResource Brush.TextMuted}" />
                        <TextBlock
                          Text="{Binding Locator}"
                          IsVisible="{Binding Locator, Converter={x:Static ObjectConverters.IsNotNull}}"
                          FontFamily="{DynamicResource Font.Mono}"
                          Foreground="{DynamicResource Brush.TextMuted}"
                        />
                      </WrapPanel>
                      <WrapPanel ItemSpacing="8" LineSpacing="6" IsVisible="{Binding CanChange}">
                        <Button
                          Content="{l:T Settings.Profiles.Use}"
                          Command="{Binding UseCommand}"
                          IsVisible="{Binding CanUse}"
                          AutomationProperties.Name="{Binding UseName}"
                        />
                        <Button
                          Content="{l:T Settings.Profiles.Edit}"
                          Command="{Binding EditCommand}"
                          AutomationProperties.Name="{Binding EditName}"
                        />
                        <Button
                          Content="{l:T Settings.Profiles.Copy}"
                          Command="{Binding CopyCommand}"
                          AutomationProperties.Name="{Binding CopyName}"
                        />
                        <Button
                          Content="{l:T Settings.Profiles.Delete}"
                          Command="{Binding DeleteCommand}"
                          IsEnabled="{Binding CanDelete}"
                          AutomationProperties.Name="{Binding DeleteName}"
                          ToolTip.Tip="{l:T Settings.Profiles.OnlyProfile}"
                          ToolTip.ShowOnDisabled="True"
                        />
                      </WrapPanel>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <WrapPanel ItemSpacing="12" LineSpacing="6">
              <Button
                x:Name="AddProfileButton"
                Content="{l:T Settings.Profiles.Add}"
                Command="{Binding Profiles.AddCommand}"
                IsVisible="{Binding !Profiles.IsReadOnly}"
              />
              <SelectableTextBlock
                x:Name="ActiveFilterLabel"
                Text="{Binding Profiles.FilterText}"
                IsVisible="{Binding Profiles.FilterText, Converter={x:Static ObjectConverters.IsNotNull}}"
                Foreground="{DynamicResource Brush.TextMuted}"
                FontFamily="{DynamicResource Font.Mono}"
                TextWrapping="Wrap"
              />
              <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding Profiles.CanUndoDelete}">
                <TextBlock x:Name="DeletedLabel" Text="{Binding Profiles.DeletedText}" VerticalAlignment="Center" />
                <Button
                  x:Name="UndoDeleteButton"
                  Content="{l:T Settings.Profiles.Undo}"
                  Command="{Binding Profiles.UndoDeleteCommand}"
                />
              </StackPanel>
            </WrapPanel>
            <TextBlock
              x:Name="ProfilesErrorLabel"
              Text="{Binding Profiles.Error}"
              IsVisible="{Binding Profiles.Error, Converter={x:Static ObjectConverters.IsNotNull}}"
              Foreground="{DynamicResource Brush.Warn}"
              TextWrapping="Wrap"
            />
          </StackPanel>

          <!-- Appearance -->
          <!-- Sources (F1.25): the master list profiles pick from, with Add a source. -->
          <StackPanel x:Name="SourcesSection" IsVisible="{Binding IsSourcesSection}" Spacing="12">
            <TextBlock
              Text="{l:T Settings.Sources.Intro}"
              Foreground="{DynamicResource Brush.TextMuted}"
              TextWrapping="Wrap"
            />
            <TextBlock
              Text="{l:T Settings.Profiles.ReadOnly}"
              IsVisible="{Binding Sources.IsReadOnly}"
              Foreground="{DynamicResource Brush.TextMuted}"
              TextWrapping="Wrap"
            />
            <ItemsControl x:Name="SourceList" ItemsSource="{Binding Sources.Rows}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="8" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="s:SourceRow">
                  <Border
                    Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="{DynamicResource Thickness.Border}"
                    CornerRadius="{DynamicResource Radius.Control}"
                    Padding="12,8"
                  >
                    <StackPanel Spacing="6">
                      <WrapPanel ItemSpacing="10">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding KindText}" Foreground="{DynamicResource Brush.TextMuted}" />
                      </WrapPanel>
                      <WrapPanel ItemSpacing="10">
                        <TextBlock Text="{Binding Server}" FontFamily="{DynamicResource Font.Mono}" />
                        <TextBlock
                          Text="{Binding Filter}"
                          IsVisible="{Binding Filter, Converter={x:Static ObjectConverters.IsNotNull}}"
                          FontFamily="{DynamicResource Font.Mono}"
                          Foreground="{DynamicResource Brush.TextMuted}"
                        />
                      </WrapPanel>
                      <TextBlock
                        Text="{Binding UsedByText}"
                        Foreground="{DynamicResource Brush.TextMuted}"
                        TextWrapping="Wrap"
                      />
                      <!-- Transmitting (F2.1 behaviors 5, 9): whether it may send, and Test send with what came of it. -->
                      <TextBlock
                        Text="{Binding TransmitText}"
                        Foreground="{DynamicResource Brush.TextMuted}"
                        FontFamily="{DynamicResource Font.Mono}"
                        TextWrapping="Wrap"
                      />
                      <TextBlock
                        Text="{Binding TestResult}"
                        IsVisible="{Binding TestResult, Converter={x:Static ObjectConverters.IsNotNull}}"
                        TextWrapping="Wrap"
                        AutomationProperties.LiveSetting="Polite"
                      />
                      <Button
                        Content="{l:T Settings.Sources.TurnTransmitOn}"
                        Command="{Binding TurnTransmitOnCommand}"
                        IsVisible="{Binding OffersTransmitOn}"
                      />
                      <WrapPanel
                        ItemSpacing="8"
                        LineSpacing="6"
                        IsVisible="{Binding !$parent[UserControl].((s:SettingsViewModel)DataContext).Sources.IsReadOnly}"
                      >
                        <Button
                          Content="{l:T Settings.Profiles.Edit}"
                          Command="{Binding EditCommand}"
                          AutomationProperties.Name="{Binding EditName}"
                        />
                        <Button
                          Content="{l:T Settings.Profiles.Delete}"
                          Command="{Binding DeleteCommand}"
                          AutomationProperties.Name="{Binding DeleteName}"
                        />
                        <Button
                          Content="{l:T Settings.Sources.TestSend}"
                          Command="{Binding TestSendCommand}"
                          IsVisible="{Binding CanTestSend}"
                          ToolTip.Tip="{l:T Settings.Sources.TestSend.Help}"
                          AutomationProperties.Name="{Binding TestSendName}"
                        />
                      </WrapPanel>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <!-- Deleting a source profiles use asks first (behavior 2). -->
            <StackPanel Spacing="8" IsVisible="{Binding Sources.IsConfirmingDelete}">
              <TextBlock Text="{Binding Sources.PendingDeleteText}" TextWrapping="Wrap" />
              <WrapPanel ItemSpacing="8">
                <Button
                  x:Name="ConfirmDeleteSourceButton"
                  Content="{l:T Settings.Sources.DeleteAnyway}"
                  Command="{Binding Sources.ConfirmDeleteCommand}"
                />
                <Button Content="{l:T Settings.Sources.Keep}" Command="{Binding Sources.CancelDeleteCommand}" />
              </WrapPanel>
            </StackPanel>
            <Button
              x:Name="AddSourceButton"
              Content="{l:T Settings.Sources.Add}"
              Command="{Binding Sources.AddCommand}"
              IsVisible="{Binding !Sources.IsReadOnly}"
            />
            <!-- The receive-only IGate (F3.4): what the profile's TNCs hear, to APRS-IS. -->
            <Border
              x:Name="IGateCard"
              IsVisible="{Binding Sources.IGateHeading, Converter={x:Static ObjectConverters.IsNotNull}}"
              Background="{DynamicResource Brush.Surface}"
              BorderBrush="{DynamicResource Brush.Border}"
              BorderThickness="{DynamicResource Thickness.Border}"
              CornerRadius="{DynamicResource Radius.Control}"
              Padding="12,8"
            >
              <StackPanel Spacing="6">
                <TextBlock Text="{Binding Sources.IGateHeading}" FontWeight="SemiBold" />
                <ToggleSwitch
                  x:Name="IGateSwitch"
                  IsChecked="{Binding Sources.IGateOn}"
                  IsEnabled="{Binding !Sources.IsReadOnly}"
                  OnContent="{l:T IGate.On}"
                  OffContent="{l:T IGate.On}"
                />
                <TextBlock Text="{l:T IGate.Help}" Foreground="{DynamicResource Brush.TextMuted}" TextWrapping="Wrap" />
                <!-- Two-way (F3.4 two-way, behavior 1): messages from APRS-IS to stations heard here. -->
                <ToggleSwitch
                  x:Name="IGateToRfSwitch"
                  IsChecked="{Binding Sources.IGateToRfOn}"
                  IsEnabled="{Binding !Sources.IsReadOnly}"
                  IsVisible="{Binding Sources.IGateOn}"
                  OnContent="{l:T IGate.ToRf}"
                  OffContent="{l:T IGate.ToRf}"
                />
                <TextBlock
                  Text="{l:T IGate.ToRfHelp}"
                  IsVisible="{Binding Sources.IGateOn}"
                  Foreground="{DynamicResource Brush.TextMuted}"
                  TextWrapping="Wrap"
                />
                <TextBlock
                  Text="{Binding Sources.IGateCountText}"
                  IsVisible="{Binding Sources.IGateCountText, Converter={x:Static ObjectConverters.IsNotNull}}"
                  TextWrapping="Wrap"
                />
                <TextBlock
                  Text="{Binding Sources.IGateHeldText}"
                  IsVisible="{Binding Sources.IGateHeldText, Converter={x:Static ObjectConverters.IsNotNull}}"
                  Foreground="{DynamicResource Brush.Warn}"
                  TextWrapping="Wrap"
                />
              </StackPanel>
            </Border>
            <!-- Add or edit: the kind (others are coming), then the details and a name (behavior 2). -->
            <Border
              x:Name="SourceForm"
              IsVisible="{Binding Sources.IsEditing}"
              Background="{DynamicResource Brush.Surface}"
              BorderBrush="{DynamicResource Brush.Border}"
              BorderThickness="{DynamicResource Thickness.Border}"
              CornerRadius="{DynamicResource Radius.Control}"
              Padding="12"
            >
              <StackPanel Spacing="8">
                <TextBlock Text="{Binding Sources.EditTitle}" FontWeight="SemiBold" />
                <ItemsControl ItemsSource="{Binding Sources.Kinds}" IsEnabled="{Binding Sources.CanPickKind}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="s:SourceKindChoice">
                      <RadioButton
                        GroupName="SourceKind"
                        Content="{Binding Name}"
                        IsEnabled="{Binding IsAvailable}"
                        IsChecked="{Binding IsSelected}"
                      />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- APRS-IS: the server as a drop-down with Custom… (F0.5 behavior 25), the filter text, and the active
                     profile's passcode when it's licensed (behaviors 26, 27). -->
                <StackPanel Spacing="8" IsVisible="{Binding Sources.IsAprsIs}">
                  <TextBlock Text="{l:T Settings.Sources.Server}" Foreground="{DynamicResource Brush.TextMuted}" />
                  <ComboBox
                    x:Name="SourceServerPicker"
                    ItemsSource="{Binding Sources.ServerOptions}"
                    SelectedItem="{Binding Sources.SelectedServerOption}"
                    AutomationProperties.Name="{l:T Settings.Sources.Server}"
                    HorizontalAlignment="Stretch"
                  />
                  <TextBox
                    x:Name="SourceServerBox"
                    IsVisible="{Binding Sources.IsCustomServer}"
                    Text="{Binding Sources.EditServer}"
                    PlaceholderText="{l:T Settings.Sources.ServerExample}"
                    AutomationProperties.Name="{l:T Settings.Sources.CustomServer}"
                    FontFamily="{DynamicResource Font.Mono}"
                  />
                  <TextBlock Text="{l:T Settings.Sources.Filter}" Foreground="{DynamicResource Brush.TextMuted}" />
                  <TextBox
                    x:Name="SourceFilterBox"
                    Text="{Binding Sources.EditFilter}"
                    AutomationProperties.Name="{l:T Settings.Sources.Filter}"
                    FontFamily="{DynamicResource Font.Mono}"
                  />
                  <!-- What the automatic filter already receives, and the filter in use (F1.2 behavior 7). -->
                  <TextBlock
                    x:Name="AutomaticFilterNote"
                    Text="{Binding Sources.AutomaticFilterText}"
                    IsVisible="{Binding Sources.AutomaticFilterText, Converter={x:Static ObjectConverters.IsNotNull}}"
                    Foreground="{DynamicResource Brush.TextMuted}"
                    TextWrapping="Wrap"
                  />
                  <TextBlock
                    x:Name="FilterInUseNote"
                    Text="{Binding Sources.FilterInUseText}"
                    IsVisible="{Binding Sources.IsAprsIs}"
                    Foreground="{DynamicResource Brush.TextMuted}"
                    FontFamily="{DynamicResource Font.Mono}"
                    TextWrapping="Wrap"
                  />
                  <StackPanel x:Name="SourcePasscode" Spacing="8" IsVisible="{Binding Sources.ShowsPasscode}">
                    <TextBlock
                      Text="{Binding Sources.PasscodeForText}"
                      Foreground="{DynamicResource Brush.TextMuted}"
                      TextWrapping="Wrap"
                    />
                    <RadioButton
                      GroupName="SourcePasscode"
                      Content="{l:T Wizard.Passcode.ReceiveOnly}"
                      IsChecked="{Binding !Sources.EditHasPasscode}"
                    />
                    <TextBlock
                      Text="{l:T Wizard.Passcode.ReceiveOnly.Help}"
                      Foreground="{DynamicResource Brush.TextMuted}"
                      TextWrapping="Wrap"
                    />
                    <RadioButton
                      x:Name="HavePasscodeChoice"
                      GroupName="SourcePasscode"
                      Content="{l:T Wizard.Passcode.Have}"
                      IsChecked="{Binding Sources.EditHasPasscode}"
                    />
                    <TextBox
                      x:Name="SourcePasscodeBox"
                      IsVisible="{Binding Sources.EditHasPasscode}"
                      Text="{Binding Sources.EditPasscode}"
                      PlaceholderText="{l:T Wizard.Passcode.Watermark}"
                      AutomationProperties.Name="{Binding Sources.PasscodeForText}"
                      FontFamily="{DynamicResource Font.Mono}"
                    />
                    <!-- The calculator (behavior 27): a tick each time, and the number shown, never filled in. -->
                    <CheckBox
                      Content="{l:T Wizard.Calculator.Licensed}"
                      IsChecked="{Binding Sources.CalculatorLicensed}"
                    />
                    <WrapPanel ItemSpacing="8" LineSpacing="6">
                      <Button
                        Content="{l:T Wizard.Calculator.Calculate}"
                        Command="{Binding Sources.CalculateCommand}"
                      />
                      <SelectableTextBlock
                        Text="{Binding Sources.CalculatedPasscode}"
                        IsVisible="{Binding Sources.CalculatedPasscode, Converter={x:Static ObjectConverters.IsNotNull}}"
                        FontFamily="{DynamicResource Font.Mono}"
                        VerticalAlignment="Center"
                      />
                    </WrapPanel>
                    <TextBlock
                      Text="{l:T Wizard.Calculator.Note}"
                      IsVisible="{Binding Sources.CalculatedPasscode, Converter={x:Static ObjectConverters.IsNotNull}}"
                      Foreground="{DynamicResource Brush.TextMuted}"
                      TextWrapping="Wrap"
                    />
                  </StackPanel>
                </StackPanel>
                <!-- KISS (F3.1 behavior 1): over TCP the TNC's host and port, on serial its port, speed and control
                     lines; then its radio port, TX path and the profiles using it. -->
                <StackPanel Spacing="8" IsVisible="{Binding Sources.IsTnc}">
                  <TextBlock
                    Text="{l:T Settings.Sources.AprsText.Help}"
                    IsVisible="{Binding Sources.ShowsTncSerialParts}"
                    Foreground="{DynamicResource Brush.TextMuted}"
                    TextWrapping="Wrap"
                  />
                  <!-- The radio's GPS in its text output (F3.13 behavior 1): Auto, On or Off. -->
                  <StackPanel x:Name="TncGpsChoice" Spacing="4" IsVisible="{Binding Sources.IsTextSerial}">
                    <TextBlock Text="{l:T Settings.Sources.TncGps}" Foreground="{DynamicResource Brush.TextMuted}" />
                    <RadioButton
                      x:Name="TncGpsAutoBox"
                      GroupName="TncGps"
                      Content="{l:T Settings.Sources.TncGps.Auto}"
                      IsChecked="{Binding Sources.TncGpsAuto}"
                    />
                    <RadioButton
                      x:Name="TncGpsOnBox"
                      GroupName="TncGps"
                      Content="{l:T Settings.Sources.TncGps.On}"
                      IsChecked="{Binding Sources.TncGpsOn}"
                    />
                    <RadioButton
                      x:Name="TncGpsOffBox"
                      GroupName="TncGps"
                      Content="{l:T Settings.Sources.TncGps.Off}"
                      IsChecked="{Binding Sources.TncGpsOff}"
                    />
                    <TextBlock
                      Text="{l:T Settings.Sources.TncGps.Help}"
                      Foreground="{DynamicResource Brush.TextMuted}"
                      TextWrapping="Wrap"
                    />
                  </StackPanel>
                  <!-- The digipeater (F3.5 behavior 1): a KISS TNC's, Off by default. -->
                  <StackPanel x:Name="DigipeatChoice" Spacing="4" IsVisible="{Binding Sources.IsKiss}">
                    <TextBlock Text="{l:T Settings.Sources.Digipeat}" Foreground="{DynamicResource Brush.TextMuted}" />
                    <RadioButton
                      x:Name="DigipeatOffBox"
                      GroupName="Digipeat"
                      Content="{l:T Settings.Sources.Digipeat.Off}"
                      IsChecked="{Binding Sources.DigipeatOff}"
                    />
                    <RadioButton
                      x:Name="DigipeatFillInBox"
                      GroupName="Digipeat"
                      Content="{l:T Settings.Sources.Digipeat.FillIn}"
                      IsChecked="{Binding Sources.DigipeatFillIn}"
                    />
                    <RadioButton
                      x:Name="DigipeatWideBox"
                      GroupName="Digipeat"
                      Content="{l:T Settings.Sources.Digipeat.Wide}"
                      IsChecked="{Binding Sources.DigipeatWide}"
                    />
                    <TextBlock
                      Text="{l:T Settings.Sources.Digipeat.Help}"
                      Foreground="{DynamicResource Brush.TextMuted}"
                      TextWrapping="Wrap"
                    />
                    <TextBlock
                      Text="{l:T Settings.Sources.Digipeat.Aliases}"
                      Foreground="{DynamicResource Brush.TextMuted}"
                      IsVisible="{Binding !Sources.DigipeatOff}"
                    />
                    <TextBox
                      x:Name="DigipeatAliasesBox"
                      Text="{Binding Sources.EditDigipeatAliases}"
                      IsVisible="{Binding !Sources.DigipeatOff}"
                      AutomationProperties.Name="{l:T Settings.Sources.Digipeat.Aliases}"
                      FontFamily="{DynamicResource Font.Mono}"
                      MinWidth="200"
                      HorizontalAlignment="Left"
                    />
                  </StackPanel>
                  <!-- A GPS (F3.6 behavior 1): NMEA on a serial port or over TCP, or gpsd. -->
                  <StackPanel x:Name="GpsLinkChoice" Spacing="4" IsVisible="{Binding Sources.IsGps}">
                    <TextBlock Text="{l:T Settings.Sources.GpsLink}" Foreground="{DynamicResource Brush.TextMuted}" />
                    <RadioButton
                      x:Name="GpsSerialBox"
                      GroupName="GpsLink"
                      Content="{l:T Settings.Sources.GpsLink.Serial}"
                      IsChecked="{Binding Sources.GpsSerial}"
                    />
                    <RadioButton
                      x:Name="GpsTcpBox"
                      GroupName="GpsLink"
                      Content="{l:T Settings.Sources.GpsLink.Tcp}"
                      IsChecked="{Binding Sources.GpsTcp}"
                    />
                    <RadioButton
                      x:Name="GpsGpsdBox"
                      GroupName="GpsLink"
                      Content="{l:T Settings.Sources.GpsLink.Gpsd}"
                      IsChecked="{Binding Sources.GpsGpsd}"
                    />
                    <TextBlock
                      Text="{l:T Settings.Sources.Gps.Help}"
                      Foreground="{DynamicResource Brush.TextMuted}"
                      TextWrapping="Wrap"
                    />
                  </StackPanel>
                  <StackPanel Spacing="8" IsVisible="{Binding Sources.ShowsHost}">
                    <TextBlock Text="{l:T Settings.Sources.Host}" Foreground="{DynamicResource Brush.TextMuted}" />
                    <TextBox
                      x:Name="SourceHostBox"
                      Text="{Binding Sources.EditHost}"
                      PlaceholderText="{l:T Settings.Sources.HostExample}"
                      AutomationProperties.Name="{l:T Settings.Sources.Host}"
                      FontFamily="{DynamicResource Font.Mono}"
                    />
                  </StackPanel>
                  <StackPanel Spacing="8" IsVisible="{Binding Sources.IsSerial}">
                    <TextBlock
                      Text="{l:T Settings.Sources.SerialPort}"
                      Foreground="{DynamicResource Brush.TextMuted}"
                    />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                      <ComboBox
                        x:Name="SerialPortBox"
                        IsEditable="True"
                        ItemsSource="{Binding Sources.SerialPorts}"
                        Text="{Binding Sources.EditSerialPort}"
                        PlaceholderText="{l:T Settings.Sources.SerialPortExample}"
                        AutomationProperties.Name="{l:T Settings.Sources.SerialPort}"
                        FontFamily="{DynamicResource Font.Mono}"
                        HorizontalAlignment="Stretch"
                      />
                      <Button
                        Grid.Column="1"
                        Content="{l:T Settings.Sources.RefreshPorts}"
                        Command="{Binding Sources.RefreshSerialPortsCommand}"
                      />
                    </Grid>
                    <TextBlock
                      Text="{Binding Sources.SerialPortsNote}"
                      IsVisible="{Binding Sources.SerialPortsNote, Converter={x:Static ObjectConverters.IsNotNull}}"
                      Foreground="{DynamicResource Brush.TextMuted}"
                      TextWrapping="Wrap"
                    />
                    <TextBlock
                      Text="{l:T Settings.Sources.SerialPort.Help}"
                      Foreground="{DynamicResource Brush.TextMuted}"
                      TextWrapping="Wrap"
                    />
                  </StackPanel>
                  <WrapPanel ItemSpacing="12">
                    <StackPanel Spacing="4" IsVisible="{Binding Sources.ShowsHost}">
                      <TextBlock Text="{l:T Settings.Sources.Port}" Foreground="{DynamicResource Brush.TextMuted}" />
                      <TextBox
                        x:Name="SourcePortBox"
                        Text="{Binding Sources.EditPort}"
                        PlaceholderText="{Binding Sources.PortPlaceholder}"
                        AutomationProperties.Name="{l:T Settings.Sources.Port}"
                        FontFamily="{DynamicResource Font.Mono}"
                        MinWidth="96"
                      />
                    </StackPanel>
                    <StackPanel Spacing="4" IsVisible="{Binding Sources.IsSerial}">
                      <TextBlock Text="{l:T Settings.Sources.Baud}" Foreground="{DynamicResource Brush.TextMuted}" />
                      <ComboBox
                        x:Name="SerialBaudBox"
                        IsEditable="True"
                        ItemsSource="{x:Static s:SourcesSectionViewModel.Bauds}"
                        Text="{Binding Sources.EditBaud}"
                        PlaceholderText="{Binding Sources.BaudPlaceholder}"
                        AutomationProperties.Name="{l:T Settings.Sources.Baud}"
                        FontFamily="{DynamicResource Font.Mono}"
                        MinWidth="128"
                      />
                    </StackPanel>
                    <StackPanel Spacing="4" IsVisible="{Binding Sources.IsKiss}">
                      <TextBlock Text="{l:T Settings.Sources.TncPort}" Foreground="{DynamicResource Brush.TextMuted}" />
                      <TextBox
                        x:Name="SourceTncPortBox"
                        Text="{Binding Sources.EditTncPort}"
                        PlaceholderText="0"
                        AutomationProperties.Name="{l:T Settings.Sources.TncPort}"
                        FontFamily="{DynamicResource Font.Mono}"
                        MinWidth="96"
                      />
                    </StackPanel>
                  </WrapPanel>
                  <StackPanel Spacing="4" IsVisible="{Binding Sources.ShowsTncSerialParts}">
                    <CheckBox
                      x:Name="SerialDtrBox"
                      Content="{l:T Settings.Sources.Dtr}"
                      IsChecked="{Binding Sources.EditDtr}"
                    />
                    <CheckBox
                      x:Name="SerialRtsBox"
                      Content="{l:T Settings.Sources.Rts}"
                      IsChecked="{Binding Sources.EditRts}"
                    />
                    <TextBlock
                      Text="{l:T Settings.Sources.ControlLines.Help}"
                      Foreground="{DynamicResource Brush.TextMuted}"
                      TextWrapping="Wrap"
                    />
                  </StackPanel>
                  <!-- TNC type (F3.2 behavior 4): how the TNC is switched into KISS when the port opens. -->
                  <StackPanel Spacing="8" IsVisible="{Binding Sources.IsKissSerial}">
                    <TextBlock Text="{l:T Settings.Sources.TncType}" Foreground="{DynamicResource Brush.TextMuted}" />
                    <ComboBox
                      x:Name="TncTypeBox"
                      ItemsSource="{Binding Sources.TncTypes}"
                      SelectedItem="{Binding Sources.SelectedTncType}"
                      AutomationProperties.Name="{l:T Settings.Sources.TncType}"
                      AutomationProperties.HelpText="{l:T Settings.Sources.TncType.Help}"
                      MinWidth="240"
                    />
                    <TextBlock
                      Text="{l:T Settings.Sources.TncType.Help}"
                      Foreground="{DynamicResource Brush.TextMuted}"
                      TextWrapping="Wrap"
                    />
                    <StackPanel Spacing="8" IsVisible="{Binding Sources.IsCustomTnc}">
                      <TextBlock
                        Text="{l:T Settings.Sources.EnterScript}"
                        Foreground="{DynamicResource Brush.TextMuted}"
                      />
                      <TextBox
                        x:Name="EnterScriptBox"
                        Text="{Binding Sources.EditEnterScript}"
                        AcceptsReturn="True"
                        TextWrapping="NoWrap"
                        MinHeight="96"
                        PlaceholderText="{l:T Settings.Sources.ScriptExample}"
                        AutomationProperties.Name="{l:T Settings.Sources.EnterScript}"
                        FontFamily="{DynamicResource Font.Mono}"
                      />
                      <TextBlock
                        Text="{l:T Settings.Sources.LeaveScript}"
                        Foreground="{DynamicResource Brush.TextMuted}"
                      />
                      <TextBox
                        x:Name="LeaveScriptBox"
                        Text="{Binding Sources.EditLeaveScript}"
                        AcceptsReturn="True"
                        TextWrapping="NoWrap"
                        MinHeight="64"
                        PlaceholderText="{l:T Settings.Sources.LeaveScriptExample}"
                        AutomationProperties.Name="{l:T Settings.Sources.LeaveScript}"
                        FontFamily="{DynamicResource Font.Mono}"
                      />
                      <TextBlock
                        Text="{l:T Settings.Sources.Script.Help}"
                        Foreground="{DynamicResource Brush.TextMuted}"
                        TextWrapping="Wrap"
                      />
                    </StackPanel>
                  </StackPanel>
                  <TextBlock
                    Text="{l:T Settings.Sources.TxPath}"
                    IsVisible="{Binding Sources.IsKiss}"
                    Foreground="{DynamicResource Brush.TextMuted}"
                  />
                  <TextBox
                    x:Name="TxPathBox"
                    IsVisible="{Binding Sources.IsKiss}"
                    Text="{Binding Sources.EditTxPath}"
                    PlaceholderText="{x:Static s:SourcesSectionViewModel.DefaultTxPath}"
                    IsEnabled="{Binding !Sources.EditRxOnly}"
                    AutomationProperties.Name="{l:T Settings.Sources.TxPath}"
                    AutomationProperties.HelpText="{l:T Settings.Sources.TxPath.Help}"
                    FontFamily="{DynamicResource Font.Mono}"
                  />
                  <TextBlock
                    Text="{l:T Settings.Sources.TxPath.Help}"
                    IsVisible="{Binding Sources.IsKiss}"
                    Foreground="{DynamicResource Brush.TextMuted}"
                    TextWrapping="Wrap"
                  />
                  <TextBlock Text="{l:T Settings.Sources.UseWith}" Foreground="{DynamicResource Brush.TextMuted}" />
                  <ItemsControl ItemsSource="{Binding Sources.EditProfiles}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="s:ProfileChoice">
                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
                <!-- RX only (F2.1 behavior 5): unticked unless chosen; a kind that can't send shows it ticked, fixed. -->
                <CheckBox
                  x:Name="RxOnlyBox"
                  Content="{l:T Settings.Sources.RxOnlyBox}"
                  IsChecked="{Binding Sources.EditRxOnly}"
                  IsEnabled="{Binding Sources.CanTransmitKind}"
                  IsVisible="{Binding !Sources.IsGps}"
                />
                <TextBlock
                  Text="{l:T Settings.Sources.RxOnlyBox.Help}"
                  IsVisible="{Binding !Sources.IsGps}"
                  Foreground="{DynamicResource Brush.TextMuted}"
                  TextWrapping="Wrap"
                />
                <TextBlock Text="{l:T Settings.Sources.Name}" Foreground="{DynamicResource Brush.TextMuted}" />
                <TextBox
                  x:Name="SourceNameBox"
                  Text="{Binding Sources.EditName}"
                  PlaceholderText="{l:T Settings.Sources.NameDefault}"
                  AutomationProperties.Name="{l:T Settings.Sources.Name}"
                />
                <TextBlock
                  Text="{Binding Sources.EditUsedBy}"
                  IsVisible="{Binding Sources.EditUsedBy, Converter={x:Static ObjectConverters.IsNotNull}}"
                  Foreground="{DynamicResource Brush.TextMuted}"
                  TextWrapping="Wrap"
                />
                <TextBlock
                  Text="{Binding Sources.Error}"
                  IsVisible="{Binding Sources.Error, Converter={x:Static ObjectConverters.IsNotNull}}"
                  Foreground="{DynamicResource Brush.Warn}"
                  TextWrapping="Wrap"
                />
                <WrapPanel ItemSpacing="8">
                  <Button
                    x:Name="SaveSourceButton"
                    Classes="accent"
                    Content="{l:T Settings.Sources.Save}"
                    Command="{Binding Sources.SaveCommand}"
                  />
                  <Button Content="{l:T Settings.Sources.Cancel}" Command="{Binding Sources.CancelCommand}" />
                </WrapPanel>
              </StackPanel>
            </Border>
          </StackPanel>
          <!-- Beacons (F2.2): the active profile's position and status beacons, each with its Send via checkmarks. -->
          <StackPanel x:Name="BeaconsSection" IsVisible="{Binding IsBeaconsSection}" Spacing="12">
            <TextBlock Text="{Binding Beacons.Heading}" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{l:T Beacons.Intro}" Foreground="{DynamicResource Brush.TextMuted}" TextWrapping="Wrap" />
            <TextBlock
              Text="{l:T Settings.Profiles.ReadOnly}"
              IsVisible="{Binding Beacons.IsReadOnly}"
              Foreground="{DynamicResource Brush.TextMuted}"
              TextWrapping="Wrap"
            />
            <TextBlock
              Text="{Binding Beacons.ListensOnlyText}"
              IsVisible="{Binding Beacons.ListensOnlyText, Converter={x:Static ObjectConverters.IsNotNull}}"
              Foreground="{DynamicResource Brush.TextMuted}"
              TextWrapping="Wrap"
            />
            <TextBlock
              Text="{Binding Beacons.NoSourcesText}"
              IsVisible="{Binding Beacons.NoSourcesText, Converter={x:Static ObjectConverters.IsNotNull}}"
              Foreground="{DynamicResource Brush.TextMuted}"
              TextWrapping="Wrap"
            />
            <TextBlock
              x:Name="BeaconsUnconfirmed"
              Text="{Binding Beacons.UnconfirmedText}"
              IsVisible="{Binding Beacons.UnconfirmedText, Converter={x:Static ObjectConverters.IsNotNull}}"
              Foreground="{DynamicResource Brush.Warn}"
              TextWrapping="Wrap"
            />
            <StackPanel Spacing="12" IsEnabled="{Binding Beacons.CanEdit}">
              <!-- The position beacon (behaviors 1, 2). -->
              <Border
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="{DynamicResource Thickness.Border}"
                CornerRadius="{DynamicResource Radius.Control}"
                Padding="12,8"
              >
                <StackPanel Spacing="8">
                  <CheckBox
                    x:Name="PositionBeaconBox"
                    Content="{l:T Beacons.PositionOn}"
                    IsChecked="{Binding Beacons.PositionOn}"
                    FontWeight="SemiBold"
                  />
                  <StackPanel Spacing="8" IsEnabled="{Binding Beacons.PositionOn}">
                    <TextBlock Text="{l:T Beacons.Schedule}" Foreground="{DynamicResource Brush.TextMuted}" />
                    <ComboBox
                      x:Name="ScheduleBox"
                      ItemsSource="{Binding Beacons.Schedules}"
                      SelectedItem="{Binding Beacons.SelectedSchedule}"
                      AutomationProperties.Name="{l:T Beacons.Schedule}"
                      MinWidth="260"
                    />
                    <TextBlock
                      Text="{l:T Beacons.Schedule.Help}"
                      Foreground="{DynamicResource Brush.TextMuted}"
                      TextWrapping="Wrap"
                    />
                    <!-- Moving (SmartBeaconing, F2.2 revised for #335): its speeds, rates and turns, in the viewer's units. -->
                    <StackPanel x:Name="MovingSettings" Spacing="8" IsVisible="{Binding Beacons.IsMoving}">
                      <TextBlock
                        Text="{l:T Beacons.Moving.Help}"
                        Foreground="{DynamicResource Brush.TextMuted}"
                        TextWrapping="Wrap"
                      />
                      <WrapPanel ItemSpacing="12" LineSpacing="8">
                        <StackPanel Spacing="4">
                          <TextBlock
                            Text="{l:T Beacons.Moving.SlowSpeed}"
                            Foreground="{DynamicResource Brush.TextMuted}"
                          />
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBox
                              x:Name="MovingSlowSpeedBox"
                              Text="{Binding Beacons.SlowSpeed}"
                              AutomationProperties.Name="{l:T Beacons.Moving.SlowSpeed}"
                              MinWidth="80"
                            />
                            <TextBlock Text="{Binding Beacons.SpeedUnitText}" VerticalAlignment="Center" />
                          </StackPanel>
                        </StackPanel>
                        <StackPanel Spacing="4">
                          <TextBlock
                            Text="{l:T Beacons.Moving.SlowRate}"
                            Foreground="{DynamicResource Brush.TextMuted}"
                          />
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBox
                              x:Name="MovingSlowRateBox"
                              Text="{Binding Beacons.SlowRateMinutes}"
                              AutomationProperties.Name="{l:T Beacons.Moving.SlowRate}"
                              MinWidth="80"
                            />
                          </StackPanel>
                        </StackPanel>
                        <StackPanel Spacing="4">
                          <TextBlock
                            Text="{l:T Beacons.Moving.FastSpeed}"
                            Foreground="{DynamicResource Brush.TextMuted}"
                          />
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBox
                              x:Name="MovingFastSpeedBox"
                              Text="{Binding Beacons.FastSpeed}"
                              AutomationProperties.Name="{l:T Beacons.Moving.FastSpeed}"
                              MinWidth="80"
                            />
                            <TextBlock Text="{Binding Beacons.SpeedUnitText}" VerticalAlignment="Center" />
                          </StackPanel>
                        </StackPanel>
                        <StackPanel Spacing="4">
                          <TextBlock
                            Text="{l:T Beacons.Moving.FastRate}"
                            Foreground="{DynamicResource Brush.TextMuted}"
                          />
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBox
                              x:Name="MovingFastRateBox"
                              Text="{Binding Beacons.FastRateSeconds}"
                              AutomationProperties.Name="{l:T Beacons.Moving.FastRate}"
                              MinWidth="80"
                            />
                          </StackPanel>
                        </StackPanel>
                      </WrapPanel>
                      <WrapPanel ItemSpacing="12" LineSpacing="8">
                        <StackPanel Spacing="4">
                          <TextBlock
                            Text="{l:T Beacons.Moving.TurnAngle}"
                            Foreground="{DynamicResource Brush.TextMuted}"
                          />
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBox
                              x:Name="MovingTurnAngleBox"
                              Text="{Binding Beacons.TurnAngle}"
                              AutomationProperties.Name="{l:T Beacons.Moving.TurnAngle}"
                              MinWidth="80"
                            />
                          </StackPanel>
                        </StackPanel>
                        <StackPanel Spacing="4">
                          <TextBlock
                            Text="{l:T Beacons.Moving.TurnSlope}"
                            Foreground="{DynamicResource Brush.TextMuted}"
                          />
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBox
                              x:Name="MovingTurnSlopeBox"
                              Text="{Binding Beacons.TurnSlope}"
                              AutomationProperties.Name="{l:T Beacons.Moving.TurnSlope}"
                              MinWidth="80"
                            />
                          </StackPanel>
                        </StackPanel>
                        <StackPanel Spacing="4">
                          <TextBlock
                            Text="{l:T Beacons.Moving.TurnTime}"
                            Foreground="{DynamicResource Brush.TextMuted}"
                          />
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBox
                              x:Name="MovingTurnTimeBox"
                              Text="{Binding Beacons.TurnTimeSeconds}"
                              AutomationProperties.Name="{l:T Beacons.Moving.TurnTime}"
                              MinWidth="80"
                            />
                          </StackPanel>
                        </StackPanel>
                      </WrapPanel>
                    </StackPanel>
                    <TextBlock Text="{l:T Beacons.Interval}" Foreground="{DynamicResource Brush.TextMuted}" />
                    <ComboBox
                      x:Name="PositionIntervalBox"
                      ItemsSource="{Binding Beacons.PositionIntervals}"
                      SelectedItem="{Binding Beacons.SelectedPositionInterval}"
                      AutomationProperties.Name="{l:T Beacons.Interval}"
                      MinWidth="260"
                    />
                    <TextBlock Text="{l:T Beacons.SendVia}" Foreground="{DynamicResource Brush.TextMuted}" />
                    <ItemsControl x:Name="PositionViaList" ItemsSource="{Binding Beacons.PositionVia}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="s:ViaChoice">
                          <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- The format (docs/features/F2.12-mic-e-status.md, behaviors 1–3): Mic-E takes a status. -->
                    <TextBlock Text="{l:T Beacons.Format}" Foreground="{DynamicResource Brush.TextMuted}" />
                    <RadioButton
                      x:Name="StandardBox"
                      GroupName="PositionFormat"
                      Content="{l:T Beacons.Format.Standard}"
                      IsChecked="{Binding Beacons.FormatStandard}"
                    />
                    <RadioButton
                      x:Name="CompressedBox"
                      GroupName="PositionFormat"
                      Content="{l:T Beacons.Compressed}"
                      IsChecked="{Binding Beacons.Compressed}"
                    />
                    <RadioButton
                      x:Name="MicEBox"
                      GroupName="PositionFormat"
                      Content="{l:T Beacons.Format.MicE}"
                      IsChecked="{Binding Beacons.MicE}"
                    />
                    <StackPanel Spacing="4" IsVisible="{Binding Beacons.MicE}">
                      <TextBlock Text="{l:T Beacons.MicEStatus}" Foreground="{DynamicResource Brush.TextMuted}" />
                      <ComboBox
                        x:Name="MicEStatusBox"
                        ItemsSource="{Binding Beacons.MicEStatuses}"
                        SelectedItem="{Binding Beacons.SelectedMicEStatus}"
                        AutomationProperties.Name="{l:T Beacons.MicEStatus}"
                        MinWidth="260"
                      />
                      <TextBlock
                        Text="{l:T Beacons.MicEStatus.Help}"
                        Foreground="{DynamicResource Brush.TextMuted}"
                        TextWrapping="Wrap"
                      />
                    </StackPanel>
                    <CheckBox
                      x:Name="PhgBox"
                      Content="{l:T Beacons.Phg}"
                      IsChecked="{Binding Beacons.IncludePhg}"
                      IsEnabled="{Binding Beacons.CanIncludePhg}"
                    />
                    <WrapPanel ItemSpacing="8" LineSpacing="8" IsVisible="{Binding Beacons.IncludePhg}">
                      <StackPanel Spacing="4">
                        <TextBlock Text="{l:T Beacons.Phg.Power}" Foreground="{DynamicResource Brush.TextMuted}" />
                        <ComboBox
                          ItemsSource="{Binding Beacons.Powers}"
                          SelectedItem="{Binding Beacons.SelectedPower}"
                          AutomationProperties.Name="{l:T Beacons.Phg.Power}"
                        />
                      </StackPanel>
                      <StackPanel Spacing="4">
                        <TextBlock Text="{l:T Beacons.Phg.Height}" Foreground="{DynamicResource Brush.TextMuted}" />
                        <ComboBox
                          ItemsSource="{Binding Beacons.Heights}"
                          SelectedItem="{Binding Beacons.SelectedHeight}"
                          AutomationProperties.Name="{l:T Beacons.Phg.Height}"
                        />
                      </StackPanel>
                      <StackPanel Spacing="4">
                        <TextBlock Text="{l:T Beacons.Phg.Gain}" Foreground="{DynamicResource Brush.TextMuted}" />
                        <ComboBox
                          ItemsSource="{Binding Beacons.Gains}"
                          SelectedItem="{Binding Beacons.SelectedGain}"
                          AutomationProperties.Name="{l:T Beacons.Phg.Gain}"
                        />
                      </StackPanel>
                      <StackPanel Spacing="4">
                        <TextBlock Text="{l:T Beacons.Phg.Direction}" Foreground="{DynamicResource Brush.TextMuted}" />
                        <ComboBox
                          ItemsSource="{Binding Beacons.Directions}"
                          SelectedItem="{Binding Beacons.SelectedDirection}"
                          AutomationProperties.Name="{l:T Beacons.Phg.Direction}"
                        />
                      </StackPanel>
                    </WrapPanel>
                  </StackPanel>
                </StackPanel>
              </Border>
              <!-- The status beacon (behavior 3). -->
              <Border
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="{DynamicResource Thickness.Border}"
                CornerRadius="{DynamicResource Radius.Control}"
                Padding="12,8"
              >
                <StackPanel Spacing="8">
                  <CheckBox
                    x:Name="StatusBeaconBox"
                    Content="{l:T Beacons.StatusOn}"
                    IsChecked="{Binding Beacons.StatusOn}"
                    FontWeight="SemiBold"
                  />
                  <!-- The text, saved texts, what's added and Send status now work with the beacon off too (F2.11). -->
                  <StackPanel Spacing="8">
                    <TextBlock Text="{l:T Beacons.StatusText}" Foreground="{DynamicResource Brush.TextMuted}" />
                    <TextBox
                      x:Name="StatusTextBox"
                      Text="{Binding Beacons.StatusText}"
                      MaxLength="{Binding Beacons.MaxStatusLength}"
                      AutomationProperties.Name="{l:T Beacons.StatusText}"
                    />
                    <TextBlock Text="{l:T Beacons.SavedTexts}" Foreground="{DynamicResource Brush.TextMuted}" />
                    <WrapPanel ItemSpacing="8" LineSpacing="8">
                      <ComboBox
                        x:Name="SavedTextsBox"
                        ItemsSource="{Binding Beacons.SavedTexts}"
                        SelectedItem="{Binding Beacons.SelectedSavedText}"
                        PlaceholderText="{l:T Beacons.SavedTexts.Choose}"
                        AutomationProperties.Name="{l:T Beacons.SavedTexts}"
                        MinWidth="260"
                      />
                      <Button
                        x:Name="SaveStatusTextButton"
                        Content="{l:T Beacons.SavedTexts.Save}"
                        Command="{Binding Beacons.SaveTextCommand}"
                      />
                      <Button
                        x:Name="RemoveStatusTextButton"
                        Content="{l:T Beacons.SavedTexts.Remove}"
                        Command="{Binding Beacons.RemoveSavedTextCommand}"
                      />
                    </WrapPanel>
                    <TextBlock Text="{l:T Beacons.StatusAdd}" Foreground="{DynamicResource Brush.TextMuted}" />
                    <ComboBox
                      x:Name="StatusAddBox"
                      ItemsSource="{Binding Beacons.Additions}"
                      SelectedItem="{Binding Beacons.SelectedAddition}"
                      AutomationProperties.Name="{l:T Beacons.StatusAdd}"
                      MinWidth="260"
                    />
                    <TextBlock
                      Text="{l:T Beacons.StatusAdd.Help}"
                      Foreground="{DynamicResource Brush.TextMuted}"
                      TextWrapping="Wrap"
                    />
                    <TextBlock Text="{l:T Beacons.Interval}" Foreground="{DynamicResource Brush.TextMuted}" />
                    <ComboBox
                      x:Name="StatusIntervalBox"
                      ItemsSource="{Binding Beacons.StatusIntervals}"
                      SelectedItem="{Binding Beacons.SelectedStatusInterval}"
                      IsEnabled="{Binding Beacons.StatusOn}"
                      AutomationProperties.Name="{l:T Beacons.Interval}"
                      MinWidth="260"
                    />
                    <TextBlock Text="{l:T Beacons.SendVia}" Foreground="{DynamicResource Brush.TextMuted}" />
                    <ItemsControl x:Name="StatusViaList" ItemsSource="{Binding Beacons.StatusVia}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="s:ViaChoice">
                          <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <WrapPanel ItemSpacing="8" LineSpacing="8">
                      <Button
                        x:Name="SendStatusNowButton"
                        Content="{l:T Beacons.SendStatusNow}"
                        Command="{Binding Beacons.SendStatusNowCommand}"
                      />
                      <TextBlock
                        Text="{Binding Beacons.StatusSentText}"
                        VerticalAlignment="Center"
                        AutomationProperties.LiveSetting="Polite"
                      />
                    </WrapPanel>
                  </StackPanel>
                </StackPanel>
              </Border>
              <TextBlock
                Text="{Binding Beacons.Error}"
                IsVisible="{Binding Beacons.Error, Converter={x:Static ObjectConverters.IsNotNull}}"
                Foreground="{DynamicResource Brush.Warn}"
                TextWrapping="Wrap"
              />
              <WrapPanel ItemSpacing="10">
                <Button
                  x:Name="SaveBeaconsButton"
                  Classes="accent"
                  Content="{l:T Beacons.Save}"
                  Command="{Binding Beacons.SaveCommand}"
                />
                <TextBlock
                  Text="{Binding Beacons.SavedText}"
                  VerticalAlignment="Center"
                  AutomationProperties.LiveSetting="Polite"
                />
              </WrapPanel>
            </StackPanel>
          </StackPanel>
          <!-- Objects (docs/features/F2.7-objects-and-items.md): placed, changed, killed and forgotten here. -->
          <StackPanel x:Name="ObjectsSection" IsVisible="{Binding IsObjectsSection}" Spacing="12">
            <TextBlock Text="{Binding Objects.Heading, FallbackValue={x:Null}}" FontWeight="SemiBold" />
            <TextBlock Text="{l:T Objects.Description}" TextWrapping="Wrap" />
            <TextBlock
              Text="{Binding Objects.EmptyText, FallbackValue={x:Null}}"
              IsVisible="{Binding Objects.EmptyText, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}"
              Foreground="{DynamicResource Brush.TextMuted}"
              TextWrapping="Wrap"
            />
            <ItemsControl x:Name="ObjectList" ItemsSource="{Binding Objects.Rows, FallbackValue={x:Null}}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="8" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="s:ObjectRow">
                  <Border
                    Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="{DynamicResource Thickness.Border}"
                    CornerRadius="{DynamicResource Radius.Control}"
                    Padding="12,8"
                  >
                    <StackPanel Spacing="6">
                      <WrapPanel ItemSpacing="10">
                        <Image
                          Source="{Binding Placed.Symbol, Converter={x:Static p:SymbolIcons.Instance}}"
                          Width="{DynamicResource Icon.Size}"
                          Height="{DynamicResource Icon.Size}"
                          VerticalAlignment="Center"
                        />
                        <TextBlock
                          Text="{Binding Name}"
                          FontWeight="SemiBold"
                          FontFamily="{DynamicResource Font.Mono}"
                        />
                        <TextBlock Text="{Binding State}" Foreground="{DynamicResource Brush.TextMuted}" />
                      </WrapPanel>
                      <TextBlock Text="{Binding Details}" TextWrapping="Wrap" />
                      <WrapPanel ItemSpacing="8" LineSpacing="6">
                        <Button
                          Content="{l:T Objects.Edit}"
                          Command="{Binding $parent[UserControl].((s:SettingsViewModel)DataContext).Objects.EditCommand}"
                          CommandParameter="{Binding}"
                          IsVisible="{Binding IsLive}"
                        />
                        <Button
                          Content="{l:T Objects.Kill}"
                          Command="{Binding $parent[UserControl].((s:SettingsViewModel)DataContext).Objects.KillCommand}"
                          CommandParameter="{Binding}"
                          IsVisible="{Binding IsLive}"
                        />
                        <Button
                          Content="{l:T Objects.Forget}"
                          Command="{Binding $parent[UserControl].((s:SettingsViewModel)DataContext).Objects.ForgetCommand}"
                          CommandParameter="{Binding}"
                        />
                      </WrapPanel>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button
              x:Name="AddObjectButton"
              Content="{l:T Objects.Add}"
              Command="{Binding Objects.AddCommand, FallbackValue={x:Null}}"
              IsVisible="{Binding !Objects.IsEditing, FallbackValue=False}"
            />
            <Border
              x:Name="ObjectForm"
              IsVisible="{Binding Objects.IsEditing, FallbackValue=False}"
              Background="{DynamicResource Brush.Surface}"
              BorderBrush="{DynamicResource Brush.Border}"
              BorderThickness="{DynamicResource Thickness.Border}"
              CornerRadius="{DynamicResource Radius.Control}"
              Padding="12"
            >
              <StackPanel Spacing="8">
                <TextBlock Text="{Binding Objects.FormHeading, FallbackValue={x:Null}}" FontWeight="SemiBold" />
                <WrapPanel ItemSpacing="12">
                  <RadioButton
                    GroupName="ObjectKind"
                    Content="{l:T Objects.Kind.Object}"
                    IsChecked="{Binding !Objects.IsItem, FallbackValue=True}"
                  />
                  <RadioButton
                    x:Name="ObjectItemBox"
                    GroupName="ObjectKind"
                    Content="{l:T Objects.Kind.Item}"
                    IsChecked="{Binding Objects.IsItem, FallbackValue=False}"
                  />
                </WrapPanel>
                <TextBlock
                  Text="{l:T Objects.Kind.Help}"
                  Foreground="{DynamicResource Brush.TextMuted}"
                  TextWrapping="Wrap"
                />
                <TextBlock Text="{l:T Objects.Name}" Foreground="{DynamicResource Brush.TextMuted}" />
                <TextBox
                  x:Name="ObjectNameBox"
                  Text="{Binding Objects.Name, FallbackValue=''}"
                  MaxLength="9"
                  FontFamily="{DynamicResource Font.Mono}"
                  AutomationProperties.Name="{l:T Objects.Name}"
                  MinWidth="160"
                  HorizontalAlignment="Left"
                />
                <TextBlock Text="{l:T Objects.Place}" Foreground="{DynamicResource Brush.TextMuted}" />
                <TextBox
                  x:Name="ObjectPlaceBox"
                  Text="{Binding Objects.CoordinatesText, FallbackValue=''}"
                  AutomationProperties.Name="{l:T Objects.Place}"
                  MinWidth="260"
                  HorizontalAlignment="Left"
                />
                <TextBlock Text="{l:T Objects.Symbol}" Foreground="{DynamicResource Brush.TextMuted}" />
                <ComboBox
                  x:Name="ObjectSymbolBox"
                  ItemsSource="{x:Static s:ObjectsSectionViewModel.Symbols}"
                  SelectedItem="{Binding Objects.SelectedSymbol, FallbackValue={x:Null}}"
                  IsTextSearchEnabled="True"
                  MaxDropDownHeight="320"
                  MinWidth="260"
                  AutomationProperties.Name="{l:T Objects.Symbol}"
                >
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:SymbolChoice">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Image
                          Source="{Binding Symbol, Converter={x:Static p:SymbolIcons.Instance}}"
                          Width="{DynamicResource Icon.Size}"
                          Height="{DynamicResource Icon.Size}"
                        />
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                      </StackPanel>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="{l:T Objects.Comment}" Foreground="{DynamicResource Brush.TextMuted}" />
                <TextBox
                  x:Name="ObjectCommentBox"
                  Text="{Binding Objects.Comment, FallbackValue=''}"
                  MaxLength="{x:Static s:ObjectsSectionViewModel.MaxCommentLength}"
                  AutomationProperties.Name="{l:T Objects.Comment}"
                />
                <TextBlock Text="{l:T Objects.Interval}" Foreground="{DynamicResource Brush.TextMuted}" />
                <ComboBox
                  x:Name="ObjectIntervalBox"
                  ItemsSource="{Binding Objects.Intervals, FallbackValue={x:Null}}"
                  SelectedItem="{Binding Objects.SelectedInterval, FallbackValue={x:Null}}"
                  AutomationProperties.Name="{l:T Objects.Interval}"
                  MinWidth="260"
                />
                <TextBlock
                  Text="{l:T Objects.Interval.Help}"
                  Foreground="{DynamicResource Brush.TextMuted}"
                  TextWrapping="Wrap"
                />
                <TextBlock Text="{l:T Beacons.SendVia}" Foreground="{DynamicResource Brush.TextMuted}" />
                <ItemsControl x:Name="ObjectViaList" ItemsSource="{Binding Objects.Via, FallbackValue={x:Null}}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="s:ViaChoice">
                      <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <WrapPanel ItemSpacing="8">
                  <Button
                    x:Name="SaveObjectButton"
                    Classes="accent"
                    Content="{l:T Objects.Save}"
                    Command="{Binding Objects.SaveObjectCommand, FallbackValue={x:Null}}"
                  />
                  <Button
                    Content="{l:T Objects.Cancel}"
                    Command="{Binding Objects.CancelEditCommand, FallbackValue={x:Null}}"
                  />
                </WrapPanel>
              </StackPanel>
            </Border>
            <TextBlock
              Text="{Binding Objects.Error, FallbackValue={x:Null}}"
              IsVisible="{Binding Objects.Error, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}"
              Foreground="{DynamicResource Brush.Warn}"
              TextWrapping="Wrap"
            />
            <TextBlock Text="{l:T Objects.Rules}" Foreground="{DynamicResource Brush.TextMuted}" TextWrapping="Wrap" />
          </StackPanel>
          <!-- Settings › Station lists (F1.33): the profile's lists, and a plain-text editor with Copy and Paste. -->
          <StackPanel x:Name="StationListsSection" IsVisible="{Binding IsStationListsSection}" Spacing="12">
            <TextBlock Text="{Binding StationLists.Heading, FallbackValue={x:Null}}" FontWeight="SemiBold" />
            <TextBlock Text="{l:T StationLists.Description}" TextWrapping="Wrap" />
            <ListBox
              x:Name="StationListPicker"
              ItemsSource="{Binding StationLists.Lists, FallbackValue={x:Null}}"
              SelectedItem="{Binding StationLists.Selected, FallbackValue={x:Null}}"
              AutomationProperties.Name="{l:T Settings.StationLists}"
              MaxHeight="240"
            >
              <ListBox.ItemTemplate>
                <DataTemplate DataType="s:StationListRow">
                  <TextBlock TextWrapping="Wrap">
                    <Run Text="{Binding Name}" FontWeight="SemiBold" />
                    <Run Text=" · " />
                    <Run Text="{Binding Count}" />
                  </TextBlock>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <Button
              x:Name="NewStationListButton"
              Content="{l:T StationLists.New}"
              Command="{Binding StationLists.NewCommand, FallbackValue={x:Null}}"
              HorizontalAlignment="Left"
            />
            <StackPanel Spacing="8" IsVisible="{Binding StationLists.IsEditing, FallbackValue=False}">
              <TextBlock Text="{l:T StationLists.Name}" Foreground="{DynamicResource Brush.TextMuted}" />
              <TextBox
                x:Name="StationListNameBox"
                Text="{Binding StationLists.Name, FallbackValue=''}"
                AutomationProperties.Name="{l:T StationLists.Name}"
                MinWidth="260"
                HorizontalAlignment="Left"
              />
              <TextBlock Text="{l:T StationLists.Entries}" Foreground="{DynamicResource Brush.TextMuted}" />
              <TextBlock
                Text="{l:T StationLists.EntriesHelp}"
                TextWrapping="Wrap"
                Foreground="{DynamicResource Brush.TextMuted}"
              />
              <TextBox
                x:Name="StationListTextBox"
                Text="{Binding StationLists.Text, FallbackValue=''}"
                AcceptsReturn="True"
                TextWrapping="NoWrap"
                FontFamily="{DynamicResource Font.Mono}"
                MinHeight="160"
                MaxHeight="360"
                AutomationProperties.Name="{l:T StationLists.Entries}"
              />
              <TextBlock
                x:Name="StationListSummary"
                Text="{Binding StationLists.Summary, FallbackValue={x:Null}}"
                TextWrapping="Wrap"
                AutomationProperties.LiveSetting="Polite"
              />
              <WrapPanel Orientation="Horizontal">
                <Button
                  x:Name="SaveStationListButton"
                  Classes="accent"
                  Content="{l:T StationLists.Save}"
                  Command="{Binding StationLists.SaveListCommand, FallbackValue={x:Null}}"
                  IsEnabled="{Binding StationLists.CanSave, FallbackValue=False}"
                  Margin="0,0,8,8"
                />
                <Button
                  Content="{l:T StationLists.CopyList}"
                  Command="{Binding StationLists.CopyListCommand, FallbackValue={x:Null}}"
                  Margin="0,0,8,8"
                />
                <Button
                  Content="{l:T StationLists.Paste}"
                  Command="{Binding StationLists.PasteCommand, FallbackValue={x:Null}}"
                  Margin="0,0,8,8"
                />
                <Button
                  Content="{l:T StationLists.Delete}"
                  Command="{Binding StationLists.DeleteCommand, FallbackValue={x:Null}}"
                  Margin="0,0,8,8"
                />
              </WrapPanel>
              <WrapPanel
                Orientation="Horizontal"
                IsVisible="{Binding !!StationLists.OtherProfiles.Count, FallbackValue=False}"
              >
                <ComboBox
                  x:Name="CopyToProfileBox"
                  ItemsSource="{Binding StationLists.OtherProfiles, FallbackValue={x:Null}}"
                  SelectedItem="{Binding StationLists.CopyTarget, FallbackValue={x:Null}}"
                  AutomationProperties.Name="{l:T StationLists.CopyToProfile}"
                  MinWidth="160"
                  Margin="0,0,8,8"
                />
                <Button
                  Content="{l:T StationLists.CopyToProfile}"
                  Command="{Binding StationLists.CopyToProfileCommand, FallbackValue={x:Null}}"
                  Margin="0,0,8,8"
                />
              </WrapPanel>
            </StackPanel>
            <TextBlock
              Text="{Binding StationLists.Message, FallbackValue={x:Null}}"
              IsVisible="{Binding StationLists.Message, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}"
              TextWrapping="Wrap"
            />
          </StackPanel>
          <StackPanel x:Name="AppearanceSection" IsVisible="{Binding IsAppearanceSection}" Spacing="20">
            <ItemsControl x:Name="AppearanceOptions" ItemsSource="{Binding AppearanceItems}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="18" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.DataTemplates>
                <DataTemplate DataType="s:ChoiceSetting">
                  <StackPanel Spacing="4">
                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                    <ComboBox
                      ItemsSource="{Binding Options}"
                      SelectedItem="{Binding Selected}"
                      AutomationProperties.Name="{Binding Label}"
                      MinWidth="260"
                    />
                    <TextBlock
                      Text="{Binding Help}"
                      IsVisible="{Binding Help, Converter={x:Static ObjectConverters.IsNotNull}}"
                      Foreground="{DynamicResource Brush.TextMuted}"
                      FontSize="{DynamicResource Text.Small}"
                      TextWrapping="Wrap"
                    />
                  </StackPanel>
                </DataTemplate>
                <DataTemplate DataType="s:ToggleSetting">
                  <StackPanel Spacing="4">
                    <CheckBox IsChecked="{Binding IsOn}" AutomationProperties.Name="{Binding Label}">
                      <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                    </CheckBox>
                    <TextBlock
                      Text="{Binding Help}"
                      IsVisible="{Binding Help, Converter={x:Static ObjectConverters.IsNotNull}}"
                      Foreground="{DynamicResource Brush.TextMuted}"
                      FontSize="{DynamicResource Text.Small}"
                      TextWrapping="Wrap"
                    />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.DataTemplates>
            </ItemsControl>
            <WrapPanel>
              <Button
                x:Name="ResetButton"
                Content="{l:T Settings.Appearance.Reset}"
                Command="{Binding ResetAppearanceCommand}"
                Margin="0,0,12,0"
              />
              <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding CanUndoReset}">
                <TextBlock
                  x:Name="ResetDoneLabel"
                  Text="{l:T Settings.Appearance.ResetDone}"
                  VerticalAlignment="Center"
                />
                <Button
                  x:Name="UndoButton"
                  Content="{l:T Settings.Appearance.Undo}"
                  Command="{Binding UndoResetCommand}"
                />
              </StackPanel>
            </WrapPanel>
          </StackPanel>

          <!-- Map (F1.4 behavior 21): the viewer's map preferences, and the station's aging where it may be changed. -->
          <!-- Layout (F1.23): the saved layouts to use, update, rename or delete, and the question. Save layout as is in
               View › Layouts (F1.29). -->
          <StackPanel x:Name="LayoutSection" IsVisible="{Binding IsLayoutSection}" Spacing="12">
            <TextBlock Text="{l:T Layouts.Description}" TextWrapping="Wrap" />
            <TextBlock
              Text="{Binding Layouts.Error}"
              IsVisible="{Binding Layouts.Error, Converter={x:Static ObjectConverters.IsNotNull}}"
              Foreground="{DynamicResource Brush.Warn}"
              TextWrapping="Wrap"
            />
            <ItemsControl x:Name="SavedLayoutRows" ItemsSource="{Binding Layouts.Layouts}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="sh:SavedLayoutRow">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,2">
                    <TextBox Text="{Binding EditName}" AutomationProperties.Name="{l:T Layouts.NamePlaceholder}" />
                    <WrapPanel Grid.Column="1" ItemSpacing="6" VerticalAlignment="Center">
                      <Button Content="{l:T Layouts.ApplyButton}" Command="{Binding ApplyCommand}" />
                      <Button Content="{l:T Layouts.UpdateButton}" Command="{Binding UpdateCommand}" />
                      <Button Content="{l:T Layouts.RenameButton}" Command="{Binding RenameCommand}" />
                      <Button Content="{l:T Layouts.DeleteButton}" Command="{Binding DeleteCommand}" />
                    </WrapPanel>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <CheckBox
              x:Name="AskLayoutBox"
              Content="{l:T Layouts.AskBox}"
              IsChecked="{Binding Layouts.Ask, FallbackValue=False}"
            />
          </StackPanel>
          <StackPanel x:Name="MapSection" IsVisible="{Binding IsMapSection}" Spacing="20">
            <ItemsControl x:Name="MapOptions" ItemsSource="{Binding MapItems}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="18" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.DataTemplates>
                <DataTemplate DataType="s:ChoiceSetting">
                  <StackPanel Spacing="4">
                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                    <ComboBox
                      ItemsSource="{Binding Options}"
                      SelectedItem="{Binding Selected}"
                      AutomationProperties.Name="{Binding Label}"
                      MinWidth="260"
                    />
                    <TextBlock
                      Text="{Binding Help}"
                      IsVisible="{Binding Help, Converter={x:Static ObjectConverters.IsNotNull}}"
                      Foreground="{DynamicResource Brush.TextMuted}"
                      FontSize="{DynamicResource Text.Small}"
                      TextWrapping="Wrap"
                    />
                  </StackPanel>
                </DataTemplate>
                <DataTemplate DataType="s:ToggleSetting">
                  <StackPanel Spacing="4">
                    <CheckBox IsChecked="{Binding IsOn}" AutomationProperties.Name="{Binding Label}">
                      <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                    </CheckBox>
                    <TextBlock
                      Text="{Binding Help}"
                      IsVisible="{Binding Help, Converter={x:Static ObjectConverters.IsNotNull}}"
                      Foreground="{DynamicResource Brush.TextMuted}"
                      FontSize="{DynamicResource Text.Small}"
                      TextWrapping="Wrap"
                    />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.DataTemplates>
            </ItemsControl>
          </StackPanel>

          <!-- Units (F1.10 behavior 6): the station's unit per quantity. -->
          <StackPanel x:Name="UnitsSection" IsVisible="{Binding IsUnitsSection}" Spacing="20">
            <ItemsControl x:Name="UnitOptions" ItemsSource="{Binding UnitItems}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="18" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.DataTemplates>
                <DataTemplate DataType="s:ChoiceSetting">
                  <StackPanel Spacing="4">
                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                    <ComboBox
                      ItemsSource="{Binding Options}"
                      SelectedItem="{Binding Selected}"
                      AutomationProperties.Name="{Binding Label}"
                      MinWidth="260"
                    />
                    <TextBlock
                      Text="{Binding Help}"
                      IsVisible="{Binding Help, Converter={x:Static ObjectConverters.IsNotNull}}"
                      Foreground="{DynamicResource Brush.TextMuted}"
                      FontSize="{DynamicResource Text.Small}"
                      TextWrapping="Wrap"
                    />
                  </StackPanel>
                </DataTemplate>
                <DataTemplate DataType="s:ToggleSetting">
                  <StackPanel Spacing="4">
                    <CheckBox IsChecked="{Binding IsOn}" AutomationProperties.Name="{Binding Label}">
                      <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                    </CheckBox>
                    <TextBlock
                      Text="{Binding Help}"
                      IsVisible="{Binding Help, Converter={x:Static ObjectConverters.IsNotNull}}"
                      Foreground="{DynamicResource Brush.TextMuted}"
                      FontSize="{DynamicResource Text.Small}"
                      TextWrapping="Wrap"
                    />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.DataTemplates>
            </ItemsControl>
          </StackPanel>

          <!-- Data: packet capture. Clear data and Start over are in the Tools menu (F1.29). -->
          <StackPanel x:Name="DataSection" IsVisible="{Binding IsDataSection}" Spacing="12">
            <!-- Packet capture (F1.27 behaviors 4, 5): off by default, with its limits. -->
            <StackPanel
              x:Name="CaptureSection"
              Spacing="8"
              IsVisible="{Binding Data.Capture, Converter={x:Static ObjectConverters.IsNotNull}}"
            >
              <TextBlock Text="{l:T Capture.Title}" FontWeight="SemiBold" />
              <TextBlock Text="{l:T Capture.Description}" TextWrapping="Wrap" />
              <ToggleSwitch
                x:Name="CaptureSwitch"
                IsChecked="{Binding Data.Capture.On, FallbackValue=False}"
                OnContent="{l:T Capture.Switch}"
                OffContent="{l:T Capture.Switch}"
              />
              <WrapPanel ItemSpacing="12" LineSpacing="8">
                <StackPanel Spacing="4">
                  <TextBlock Text="{l:T Capture.MaxMegabytes}" Foreground="{DynamicResource Brush.TextMuted}" />
                  <TextBox
                    x:Name="CaptureMegabytesBox"
                    Text="{Binding Data.Capture.MaxMegabytes, FallbackValue=''}"
                    AutomationProperties.Name="{l:T Capture.MaxMegabytes}"
                    MinWidth="96"
                  />
                </StackPanel>
                <StackPanel Spacing="4">
                  <TextBlock Text="{l:T Capture.Days}" Foreground="{DynamicResource Brush.TextMuted}" />
                  <TextBox
                    x:Name="CaptureDaysBox"
                    Text="{Binding Data.Capture.Days, FallbackValue=''}"
                    AutomationProperties.Name="{l:T Capture.Days}"
                    MinWidth="96"
                  />
                </StackPanel>
              </WrapPanel>
              <CheckBox
                x:Name="CaptureUserDefinedBox"
                Content="{l:T Capture.UserDefined}"
                IsChecked="{Binding Data.Capture.UserDefined, FallbackValue=False}"
              />
              <WrapPanel ItemSpacing="8" LineSpacing="8">
                <Button
                  x:Name="CaptureSaveButton"
                  Content="{l:T Capture.Save}"
                  Command="{Binding Data.Capture.SaveCommand}"
                />
                <TextBlock Text="{Binding Data.Capture.SavedText}" VerticalAlignment="Center" />
              </WrapPanel>
              <TextBlock
                Text="{Binding Data.Capture.Error}"
                IsVisible="{Binding Data.Capture.Error, Converter={x:Static ObjectConverters.IsNotNull}}"
                Foreground="{DynamicResource Brush.Warn}"
                TextWrapping="Wrap"
              />
            </StackPanel>
            <!-- Updates (docs/features/F4.15-updates.md, behaviors 5, 6, 9.3, 10). -->
            <StackPanel
              x:Name="UpdatesSection"
              Spacing="8"
              IsVisible="{Binding Data.UpdateChecks, Converter={x:Static ObjectConverters.IsNotNull}}"
            >
              <TextBlock Text="{l:T Updates.Settings.Title}" FontWeight="SemiBold" />
              <TextBlock Text="{l:T Updates.Settings.Description}" TextWrapping="Wrap" />
              <ToggleSwitch
                x:Name="UpdateCheckSwitch"
                IsChecked="{Binding Data.UpdateChecks.CheckOn, FallbackValue=False}"
                OnContent="{l:T Updates.Settings.Check}"
                OffContent="{l:T Updates.Settings.Check}"
              />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{l:T Updates.Settings.Channel}" VerticalAlignment="Center" />
                <ComboBox
                  x:Name="UpdateChannel"
                  ItemsSource="{Binding Data.UpdateChecks.ChannelOptions, FallbackValue={x:Null}}"
                  SelectedItem="{Binding Data.UpdateChecks.Channel, FallbackValue={x:Null}}"
                  AutomationProperties.Name="{l:T Updates.Settings.Channel}"
                />
              </StackPanel>
              <WrapPanel ItemSpacing="12" LineSpacing="8">
                <TextBlock
                  x:Name="UpdateStatusText"
                  Text="{Binding Data.UpdateChecks.StatusText, FallbackValue={x:Null}}"
                  Foreground="{DynamicResource Brush.TextMuted}"
                  TextWrapping="Wrap"
                  VerticalAlignment="Center"
                />
                <Button
                  x:Name="UpdateCheckNow"
                  Content="{l:T Updates.CheckNow}"
                  Command="{Binding Data.UpdateChecks.CheckNowCommand, FallbackValue={x:Null}}"
                />
              </WrapPanel>
              <WrapPanel
                ItemSpacing="12"
                LineSpacing="8"
                IsVisible="{Binding Data.UpdateChecks.SkippedText, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}"
              >
                <TextBlock
                  x:Name="UpdateSkipped"
                  Text="{Binding Data.UpdateChecks.SkippedText, FallbackValue={x:Null}}"
                  VerticalAlignment="Center"
                />
                <Button
                  x:Name="UpdateOfferAgain"
                  Content="{l:T Updates.OfferAgain}"
                  Command="{Binding Data.UpdateChecks.OfferAgainCommand, FallbackValue={x:Null}}"
                />
              </WrapPanel>
              <TextBlock
                Text="{Binding Data.UpdateChecks.Error, FallbackValue={x:Null}}"
                IsVisible="{Binding Data.UpdateChecks.Error, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}"
                Foreground="{DynamicResource Brush.Warn}"
                TextWrapping="Wrap"
              />
            </StackPanel>
            <!-- The device list (docs/features/F4.16-device-list.md, behaviors 4, 5, 9, 10). -->
            <StackPanel
              x:Name="DeviceListSection"
              Spacing="8"
              IsVisible="{Binding Data.DeviceList, Converter={x:Static ObjectConverters.IsNotNull}}"
            >
              <TextBlock Text="{l:T DeviceList.Title}" FontWeight="SemiBold" />
              <TextBlock Text="{l:T DeviceList.Description}" TextWrapping="Wrap" />
              <TextBlock x:Name="DeviceListInUse" Text="{Binding Data.DeviceList.InUseText, FallbackValue={x:Null}}" />
              <TextBlock
                x:Name="DeviceListChecked"
                Text="{Binding Data.DeviceList.CheckedText, FallbackValue={x:Null}}"
                Classes.warn="{Binding Data.DeviceList.CheckFailed, FallbackValue=False}"
                TextWrapping="Wrap"
                AutomationProperties.LiveSetting="Polite"
              />
              <WrapPanel
                ItemSpacing="12"
                LineSpacing="8"
                IsVisible="{Binding Data.DeviceList.ShowsChecks, FallbackValue=False}"
              >
                <Button
                  x:Name="DeviceListUpdateNow"
                  Content="{l:T DeviceList.UpdateNow}"
                  Command="{Binding Data.DeviceList.UpdateNowCommand, FallbackValue={x:Null}}"
                />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{l:T DeviceList.Schedule}" VerticalAlignment="Center" />
                  <ComboBox
                    x:Name="DeviceListSchedule"
                    ItemsSource="{Binding Data.DeviceList.ScheduleOptions, FallbackValue={x:Null}}"
                    SelectedItem="{Binding Data.DeviceList.Schedule, FallbackValue={x:Null}}"
                    AutomationProperties.Name="{l:T DeviceList.Schedule}"
                  />
                </StackPanel>
              </WrapPanel>
              <Expander
                x:Name="DeviceListAdvanced"
                Header="{l:T DeviceList.Advanced}"
                IsVisible="{Binding Data.DeviceList.ShowsUrl, FallbackValue=False}"
                HorizontalAlignment="Stretch"
              >
                <StackPanel Spacing="8">
                  <TextBlock Text="{l:T DeviceList.UrlHelp}" TextWrapping="Wrap" />
                  <TextBox
                    x:Name="DeviceListUrl"
                    Text="{Binding Data.DeviceList.Url, FallbackValue=''}"
                    AutomationProperties.Name="{l:T DeviceList.Url}"
                  />
                  <WrapPanel ItemSpacing="8">
                    <Button
                      Content="{l:T DeviceList.SaveUrl}"
                      Command="{Binding Data.DeviceList.SaveUrlCommand, FallbackValue={x:Null}}"
                    />
                    <Button
                      Content="{l:T DeviceList.ResetUrl}"
                      Command="{Binding Data.DeviceList.ResetUrlCommand, FallbackValue={x:Null}}"
                    />
                  </WrapPanel>
                  <TextBlock
                    Text="{Binding Data.DeviceList.UrlError, FallbackValue={x:Null}}"
                    IsVisible="{Binding Data.DeviceList.UrlError, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}"
                    Foreground="{DynamicResource Brush.Warn}"
                    TextWrapping="Wrap"
                  />
                </StackPanel>
              </Expander>
              <TextBlock
                Text="{l:T DeviceList.Credit}"
                Foreground="{DynamicResource Brush.TextMuted}"
                TextWrapping="Wrap"
              />
            </StackPanel>
          </StackPanel>
          <!-- Connection (docs/features/F1.39-desktop-gateway-client.md): this computer's station, or a gateway's. -->
          <StackPanel x:Name="ConnectionSection" IsVisible="{Binding IsConnectionSection}" Spacing="10">
            <TextBlock Text="{l:T Connection.Title}" FontWeight="SemiBold" />
            <TextBlock Text="{l:T Connection.Description}" TextWrapping="Wrap" />
            <TextBlock
              x:Name="ConnectionStatus"
              Text="{Binding Connection.StatusText, FallbackValue={x:Null}}"
              Classes.warn="{Binding Connection.HasProblem, FallbackValue=False}"
              TextWrapping="Wrap"
              AutomationProperties.LiveSetting="Polite"
            />
            <RadioButton
              x:Name="ConnectionThisComputer"
              GroupName="ConnectionChoice"
              IsChecked="{Binding Connection.ThisComputer, FallbackValue=True}"
              Content="{l:T Connection.ThisComputer}"
            />
            <RadioButton
              x:Name="ConnectionGateway"
              GroupName="ConnectionChoice"
              IsChecked="{Binding Connection.UseGateway, FallbackValue=False}"
              Content="{l:T Connection.Gateway}"
            />
            <StackPanel Spacing="4" IsEnabled="{Binding Connection.UseGateway, FallbackValue=False}">
              <TextBlock Text="{l:T Connection.Address}" Foreground="{DynamicResource Brush.TextMuted}" />
              <TextBox
                x:Name="ConnectionAddress"
                Text="{Binding Connection.Address, FallbackValue=''}"
                PlaceholderText="{l:T Connection.AddressHint}"
                AutomationProperties.Name="{l:T Connection.Address}"
              />
              <TextBlock
                x:Name="ConnectionAddressError"
                Text="{Binding Connection.AddressError, FallbackValue={x:Null}}"
                IsVisible="{Binding Connection.AddressError, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}"
                Foreground="{DynamicResource Brush.Warn}"
                TextWrapping="Wrap"
              />
              <TextBlock
                Text="{l:T Connection.ApiKey}"
                Foreground="{DynamicResource Brush.TextMuted}"
                Margin="0,6,0,0"
              />
              <TextBox
                x:Name="ConnectionApiKey"
                Text="{Binding Connection.ApiKey, FallbackValue=''}"
                PasswordChar="•"
                RevealPassword="{Binding Connection.ShowKey, FallbackValue=False}"
                PlaceholderText="{l:T Connection.ApiKeyHint}"
                FontFamily="{DynamicResource Font.Mono}"
                AutomationProperties.Name="{l:T Connection.ApiKey}"
              />
              <CheckBox
                x:Name="ConnectionShowKey"
                IsChecked="{Binding Connection.ShowKey, FallbackValue=False}"
                Content="{l:T Connection.ShowKey}"
              />
            </StackPanel>
            <TextBlock
              x:Name="ConnectionTestResult"
              Text="{Binding Connection.TestText, FallbackValue={x:Null}}"
              IsVisible="{Binding Connection.TestText, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}"
              Classes.warn="{Binding Connection.TestNeedsAttention, FallbackValue=False}"
              TextWrapping="Wrap"
              AutomationProperties.LiveSetting="Polite"
            />
            <WrapPanel ItemSpacing="8">
              <Button
                x:Name="ConnectionTest"
                Content="{l:T Connection.Test}"
                Command="{Binding Connection.TestCommand, FallbackValue={x:Null}}"
                ToolTip.Tip="{l:T Connection.Test.Hint}"
              />
              <Button
                x:Name="ConnectionApply"
                Content="{l:T Connection.Apply}"
                Command="{Binding Connection.ApplyCommand, FallbackValue={x:Null}}"
              />
            </WrapPanel>
            <TextBlock
              x:Name="ConnectionMessage"
              Text="{Binding Connection.Message, FallbackValue={x:Null}}"
              IsVisible="{Binding Connection.Message, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}"
              TextWrapping="Wrap"
              AutomationProperties.LiveSetting="Polite"
            />
          </StackPanel>
          <!-- Gateway access (docs/features/F1.38-gateway-api-key.md): the API key for apps that control the gateway. -->
          <StackPanel x:Name="GatewayAccessSection" IsVisible="{Binding IsGatewayAccessSection}" Spacing="10">
            <TextBlock Text="{l:T GatewayAccess.Title}" FontWeight="SemiBold" />
            <TextBlock Text="{l:T GatewayAccess.Description}" TextWrapping="Wrap" />
            <ToggleSwitch
              x:Name="GatewayAccessSwitch"
              IsChecked="{Binding GatewayAccess.On, FallbackValue=False}"
              OnContent="{l:T GatewayAccess.On}"
              OffContent="{l:T GatewayAccess.On}"
            />
            <TextBlock
              x:Name="GatewayAccessStatus"
              Text="{Binding GatewayAccess.StatusText, FallbackValue={x:Null}}"
              TextWrapping="Wrap"
              AutomationProperties.LiveSetting="Polite"
            />
            <StackPanel Spacing="4" IsEnabled="{Binding GatewayAccess.On, FallbackValue=False}">
              <TextBlock Text="{l:T GatewayAccess.Key}" Foreground="{DynamicResource Brush.TextMuted}" />
              <TextBox
                x:Name="GatewayAccessKey"
                Text="{Binding GatewayAccess.Key, FallbackValue=''}"
                PlaceholderText="{l:T GatewayAccess.KeyHint}"
                FontFamily="{DynamicResource Font.Mono}"
                AutomationProperties.Name="{l:T GatewayAccess.Key}"
              />
              <WrapPanel ItemSpacing="8" Margin="0,4,0,0">
                <Button
                  x:Name="GatewayAccessGenerate"
                  Content="{l:T GatewayAccess.Generate}"
                  Command="{Binding GatewayAccess.GenerateCommand, FallbackValue={x:Null}}"
                />
                <Button
                  x:Name="GatewayAccessCopy"
                  Content="{l:T GatewayAccess.Copy}"
                  Command="{Binding GatewayAccess.CopyCommand, FallbackValue={x:Null}}"
                />
              </WrapPanel>
            </StackPanel>
            <Button
              x:Name="GatewayAccessApply"
              Content="{l:T WebViewer.Apply}"
              Command="{Binding GatewayAccess.ApplyCommand, FallbackValue={x:Null}}"
              HorizontalAlignment="Left"
            />
            <TextBlock
              x:Name="GatewayAccessMessage"
              Text="{Binding GatewayAccess.Message, FallbackValue={x:Null}}"
              IsVisible="{Binding GatewayAccess.Message, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}"
              Classes.warn="{Binding GatewayAccess.HasProblem, FallbackValue=False}"
              TextWrapping="Wrap"
              AutomationProperties.LiveSetting="Polite"
            />
          </StackPanel>
          <!-- Web viewer (docs/features/F1.35-desktop-web-viewer.md): this station served to browsers, view only. -->
          <StackPanel x:Name="WebViewerSection" IsVisible="{Binding IsWebViewerSection}" Spacing="10">
            <TextBlock Text="{l:T WebViewer.Title}" FontWeight="SemiBold" />
            <TextBlock Text="{l:T WebViewer.Description}" TextWrapping="Wrap" />
            <ToggleSwitch
              x:Name="WebViewerSwitch"
              IsChecked="{Binding WebViewer.On, FallbackValue=False}"
              IsEnabled="{Binding WebViewer.Available, FallbackValue=False}"
              OnContent="{l:T WebViewer.On}"
              OffContent="{l:T WebViewer.On}"
            />
            <TextBlock
              x:Name="WebViewerStatus"
              Text="{Binding WebViewer.StatusText, FallbackValue={x:Null}}"
              Classes.warn="{Binding WebViewer.HasProblem, FallbackValue=False}"
              TextWrapping="Wrap"
              AutomationProperties.LiveSetting="Polite"
            />
            <ItemsControl
              x:Name="WebViewerAddresses"
              ItemsSource="{Binding WebViewer.Addresses, FallbackValue={x:Null}}"
            >
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="s:WebViewerAddress">
                  <WrapPanel ItemSpacing="8" Margin="0,0,0,4">
                    <SelectableTextBlock
                      Text="{Binding Address}"
                      FontFamily="{DynamicResource Font.Mono}"
                      VerticalAlignment="Center"
                    />
                    <Button
                      Content="{l:T About.Folder.Copy}"
                      Command="{Binding Copy}"
                      AutomationProperties.Name="{Binding Address}"
                    />
                  </WrapPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{l:T WebViewer.Who}" FontWeight="SemiBold" Margin="0,6,0,0" />
            <RadioButton
              x:Name="WebViewerThisComputer"
              GroupName="WebViewerWho"
              IsChecked="{Binding WebViewer.ThisComputerOnly, FallbackValue=True}"
              Content="{l:T WebViewer.ThisComputer}"
            />
            <RadioButton
              x:Name="WebViewerLocalNetwork"
              GroupName="WebViewerWho"
              IsChecked="{Binding WebViewer.LocalNetwork, FallbackValue=False}"
            >
              <TextBlock Text="{l:T WebViewer.LocalNetwork}" TextWrapping="Wrap" />
            </RadioButton>
            <WrapPanel ItemSpacing="12" LineSpacing="8">
              <StackPanel Spacing="4">
                <TextBlock Text="{l:T WebViewer.Port}" Foreground="{DynamicResource Brush.TextMuted}" />
                <TextBox
                  x:Name="WebViewerPort"
                  Text="{Binding WebViewer.Port, FallbackValue=''}"
                  AutomationProperties.Name="{l:T WebViewer.Port}"
                  MinWidth="100"
                />
              </StackPanel>
              <StackPanel Spacing="4">
                <TextBlock Text="{l:T WebViewer.Location}" Foreground="{DynamicResource Brush.TextMuted}" />
                <ComboBox
                  x:Name="WebViewerLocation"
                  ItemsSource="{Binding WebViewer.LocationOptions, FallbackValue={x:Null}}"
                  SelectedItem="{Binding WebViewer.Location, FallbackValue={x:Null}}"
                  AutomationProperties.Name="{l:T WebViewer.Location}"
                />
              </StackPanel>
            </WrapPanel>
            <TextBlock
              Text="{Binding WebViewer.PortError, FallbackValue={x:Null}}"
              IsVisible="{Binding WebViewer.PortError, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}"
              Foreground="{DynamicResource Brush.Warn}"
              TextWrapping="Wrap"
            />
            <Button
              x:Name="WebViewerApply"
              Content="{l:T WebViewer.Apply}"
              Command="{Binding WebViewer.ApplyCommand, FallbackValue={x:Null}}"
              HorizontalAlignment="Left"
            />
            <TextBlock
              Text="{l:T WebViewer.Firewall}"
              IsVisible="{Binding WebViewer.LocalNetwork, FallbackValue=False}"
              Foreground="{DynamicResource Brush.TextMuted}"
              TextWrapping="Wrap"
            />
          </StackPanel>
          <!-- Messaging (docs/features/F2.13-ping.md): the active profile's ping responder, off by default. -->
          <StackPanel x:Name="MessagingSection" IsVisible="{Binding IsMessagingSection}" Spacing="10">
            <TextBlock Text="{Binding Messaging.Heading, FallbackValue={x:Null}}" FontWeight="SemiBold" />
            <TextBlock Text="{l:T Ping.Description}" TextWrapping="Wrap" />
            <ToggleSwitch
              x:Name="PingSwitch"
              IsChecked="{Binding Messaging.On, FallbackValue=False}"
              OnContent="{l:T Ping.On}"
              OffContent="{l:T Ping.On}"
            />
            <WrapPanel ItemSpacing="12" LineSpacing="8">
              <StackPanel Spacing="4">
                <TextBlock Text="{l:T Ping.Phrase}" Foreground="{DynamicResource Brush.TextMuted}" />
                <TextBox
                  x:Name="PingPhraseBox"
                  Text="{Binding Messaging.PingPhrase, FallbackValue=''}"
                  PlaceholderText="{x:Static s:MessagingSectionViewModel.DefaultPing}"
                  AutomationProperties.Name="{l:T Ping.Phrase}"
                  MinWidth="240"
                />
              </StackPanel>
              <StackPanel Spacing="4">
                <TextBlock Text="{l:T Ping.PongPhrase}" Foreground="{DynamicResource Brush.TextMuted}" />
                <TextBox
                  x:Name="PongPhraseBox"
                  Text="{Binding Messaging.PongPhrase, FallbackValue=''}"
                  PlaceholderText="{x:Static s:MessagingSectionViewModel.DefaultPong}"
                  AutomationProperties.Name="{l:T Ping.PongPhrase}"
                  MinWidth="240"
                />
              </StackPanel>
            </WrapPanel>
            <TextBlock
              Text="{l:T Ping.PhraseHelp}"
              Foreground="{DynamicResource Brush.TextMuted}"
              TextWrapping="Wrap"
            />
            <TextBlock Text="{l:T Ping.Who}" Foreground="{DynamicResource Brush.TextMuted}" />
            <RadioButton
              GroupName="PingWho"
              Content="{l:T Ping.Who.Anyone}"
              IsChecked="{Binding Messaging.WhoAnyone, FallbackValue=True}"
            />
            <RadioButton
              GroupName="PingWho"
              Content="{l:T Ping.Who.MyCallsign}"
              IsChecked="{Binding Messaging.WhoMyCallsign, FallbackValue=False}"
            />
            <RadioButton
              GroupName="PingWho"
              Content="{l:T Ping.Who.Callsigns}"
              IsChecked="{Binding Messaging.WhoCallsigns, FallbackValue=False}"
            />
            <StackPanel Spacing="4" IsVisible="{Binding Messaging.ShowsCallsigns, FallbackValue=False}">
              <TextBox
                x:Name="PingCallsignsBox"
                Text="{Binding Messaging.Callsigns, FallbackValue=''}"
                AcceptsReturn="True"
                MinHeight="72"
                AutomationProperties.Name="{l:T Ping.Who.Callsigns}"
                FontFamily="{DynamicResource Font.Mono}"
              />
              <TextBlock
                Text="{l:T Ping.CallsignsHelp}"
                Foreground="{DynamicResource Brush.TextMuted}"
                TextWrapping="Wrap"
              />
            </StackPanel>
            <StackPanel Spacing="4">
              <TextBlock Text="{l:T Ping.Interval}" Foreground="{DynamicResource Brush.TextMuted}" />
              <TextBox
                x:Name="PingIntervalBox"
                Text="{Binding Messaging.IntervalSeconds, FallbackValue=''}"
                AutomationProperties.Name="{l:T Ping.Interval}"
                MinWidth="96"
                HorizontalAlignment="Left"
              />
              <TextBlock
                Text="{l:T Ping.IntervalHelp}"
                Foreground="{DynamicResource Brush.TextMuted}"
                TextWrapping="Wrap"
              />
            </StackPanel>
            <!-- Auto-reply (docs/features/F2.10-auto-reply.md): the away message, saved with the ping settings. -->
            <TextBlock Text="{Binding Messaging.AutoReplyHeading, FallbackValue={x:Null}}" FontWeight="SemiBold" />
            <TextBlock Text="{l:T AutoReply.Description}" TextWrapping="Wrap" />
            <ToggleSwitch
              x:Name="AutoReplySwitch"
              IsChecked="{Binding Messaging.AutoReplyOn, FallbackValue=False}"
              OnContent="{l:T AutoReply.On}"
              OffContent="{l:T AutoReply.On}"
            />
            <StackPanel Spacing="4">
              <TextBlock Text="{l:T AutoReply.Text}" Foreground="{DynamicResource Brush.TextMuted}" />
              <TextBox
                x:Name="AutoReplyTextBox"
                Text="{Binding Messaging.AutoReplyText, FallbackValue=''}"
                PlaceholderText="{x:Static s:MessagingSectionViewModel.DefaultAutoReply}"
                AutomationProperties.Name="{l:T AutoReply.Text}"
                MaxLength="67"
                MinWidth="240"
              />
            </StackPanel>
            <StackPanel Spacing="10">
              <StackPanel Spacing="4">
                <TextBlock Text="{l:T AutoReply.Away}" Foreground="{DynamicResource Brush.TextMuted}" />
                <TextBox
                  x:Name="AutoReplyAwayBox"
                  Text="{Binding Messaging.AwayMinutes, FallbackValue=''}"
                  AutomationProperties.Name="{l:T AutoReply.Away}"
                  MinWidth="96"
                  HorizontalAlignment="Left"
                />
                <TextBlock
                  Text="{l:T AutoReply.AwayHelp}"
                  Foreground="{DynamicResource Brush.TextMuted}"
                  TextWrapping="Wrap"
                />
              </StackPanel>
              <StackPanel Spacing="4">
                <TextBlock Text="{l:T AutoReply.OncePer}" Foreground="{DynamicResource Brush.TextMuted}" />
                <TextBox
                  x:Name="AutoReplyOncePerBox"
                  Text="{Binding Messaging.OncePerMinutes, FallbackValue=''}"
                  AutomationProperties.Name="{l:T AutoReply.OncePer}"
                  MinWidth="96"
                  HorizontalAlignment="Left"
                />
                <TextBlock
                  Text="{l:T AutoReply.OncePerHelp}"
                  Foreground="{DynamicResource Brush.TextMuted}"
                  TextWrapping="Wrap"
                />
              </StackPanel>
              <StackPanel Spacing="4">
                <TextBlock Text="{l:T AutoReply.Delay}" Foreground="{DynamicResource Brush.TextMuted}" />
                <TextBox
                  x:Name="AutoReplyDelayBox"
                  Text="{Binding Messaging.DelaySeconds, FallbackValue=''}"
                  AutomationProperties.Name="{l:T AutoReply.Delay}"
                  MinWidth="96"
                  HorizontalAlignment="Left"
                />
                <TextBlock
                  Text="{l:T AutoReply.DelayHelp}"
                  Foreground="{DynamicResource Brush.TextMuted}"
                  TextWrapping="Wrap"
                />
              </StackPanel>
            </StackPanel>
            <TextBlock
              Text="{l:T AutoReply.Never}"
              Foreground="{DynamicResource Brush.TextMuted}"
              TextWrapping="Wrap"
            />
            <!-- Queries (F2.8): answered as APRS expects, under every transmit rule. -->
            <TextBlock Text="{l:T Queries.Heading}" FontWeight="SemiBold" />
            <ToggleSwitch
              x:Name="AnswerQueriesSwitch"
              IsChecked="{Binding Messaging.AnswerQueries, FallbackValue=True}"
              OnContent="{l:T Queries.On}"
              OffContent="{l:T Queries.On}"
            />
            <TextBlock Text="{l:T Queries.Help}" Foreground="{DynamicResource Brush.TextMuted}" TextWrapping="Wrap" />
            <TextBlock Text="{l:T Ping.Rules}" Foreground="{DynamicResource Brush.TextMuted}" TextWrapping="Wrap" />
            <WrapPanel ItemSpacing="8" LineSpacing="8">
              <Button
                x:Name="PingSaveButton"
                Content="{l:T Ping.Save}"
                Command="{Binding Messaging.SaveCommand, FallbackValue={x:Null}}"
              />
              <TextBlock Text="{Binding Messaging.SavedText, FallbackValue={x:Null}}" VerticalAlignment="Center" />
            </WrapPanel>
            <TextBlock
              Text="{Binding Messaging.Error, FallbackValue={x:Null}}"
              IsVisible="{Binding Messaging.Error, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}"
              Foreground="{DynamicResource Brush.Warn}"
              TextWrapping="Wrap"
            />
          </StackPanel>
          <!-- Logging (docs/features/F1.32-logging.md): levels, privacy, the log file and OTLP targets, saved with Save. -->
          <StackPanel x:Name="LoggingSection" IsVisible="{Binding IsLoggingSection}" Spacing="12">
            <TextBlock Text="{l:T Logging.WhatToLog}" FontWeight="SemiBold" />
            <StackPanel Spacing="4">
              <TextBlock Text="{l:T Logging.Overall}" Foreground="{DynamicResource Brush.TextMuted}" />
              <ComboBox
                x:Name="LogLevelBox"
                ItemsSource="{Binding Logging.Levels, FallbackValue={x:Null}}"
                SelectedItem="{Binding Logging.SelectedLevel, FallbackValue={x:Null}}"
                IsEnabled="{Binding !Logging.LevelFromEnvironment, FallbackValue=True}"
                AutomationProperties.Name="{l:T Logging.Overall}"
                MinWidth="180"
              />
              <TextBlock
                Text="{l:T Logging.FromEnvironment}"
                IsVisible="{Binding Logging.LevelFromEnvironment, FallbackValue=False}"
                Foreground="{DynamicResource Brush.TextMuted}"
              />
            </StackPanel>
            <TextBlock Text="{l:T Logging.Areas}" Foreground="{DynamicResource Brush.TextMuted}" />
            <ItemsControl x:Name="LogAreas" ItemsSource="{Binding Logging.Areas, FallbackValue={x:Null}}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="s:LogAreaRow">
                  <WrapPanel ItemSpacing="12" LineSpacing="4" Margin="0,2">
                    <TextBlock Text="{Binding Name}" MinWidth="200" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <ComboBox
                      ItemsSource="{Binding Choices}"
                      SelectedItem="{Binding Selected}"
                      IsEnabled="{Binding CanChange}"
                      AutomationProperties.Name="{Binding Name}"
                      MinWidth="180"
                    />
                    <TextBlock
                      Text="{l:T Logging.FromEnvironment}"
                      IsVisible="{Binding FromEnvironment}"
                      Foreground="{DynamicResource Brush.TextMuted}"
                      VerticalAlignment="Center"
                    />
                  </WrapPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <CheckBox
              x:Name="LogPacketsBox"
              Content="{l:T Logging.Packets}"
              IsChecked="{Binding Logging.Packets, FallbackValue=False}"
            />
            <TextBlock
              Text="{l:T Logging.Packets.Help}"
              Foreground="{DynamicResource Brush.TextMuted}"
              TextWrapping="Wrap"
            />
            <CheckBox
              x:Name="LogMessageTextsBox"
              Content="{l:T Logging.MessageTexts}"
              IsChecked="{Binding Logging.MessageTexts, FallbackValue=False}"
            />
            <TextBlock
              Text="{l:T Logging.MessageTexts.Help}"
              Foreground="{DynamicResource Brush.TextMuted}"
              TextWrapping="Wrap"
            />
            <TextBlock Text="{l:T Logging.Never}" Foreground="{DynamicResource Brush.TextMuted}" TextWrapping="Wrap" />

            <TextBlock Text="{l:T Logging.File}" FontWeight="SemiBold" Margin="0,8,0,0" />
            <ToggleSwitch
              x:Name="LogFileSwitch"
              IsChecked="{Binding Logging.FileOn, FallbackValue=False}"
              OnContent="{l:T Logging.FileOn}"
              OffContent="{l:T Logging.FileOn}"
            />
            <StackPanel Spacing="4" IsVisible="{Binding Logging.FileOn, FallbackValue=False}">
              <TextBlock Text="{l:T Logging.Folder}" Foreground="{DynamicResource Brush.TextMuted}" />
              <TextBox
                x:Name="LogFolderBox"
                Text="{Binding Logging.Folder, FallbackValue=''}"
                PlaceholderText="{Binding Logging.DefaultFolder, FallbackValue=''}"
                AutomationProperties.Name="{l:T Logging.Folder}"
                FontFamily="{DynamicResource Font.Mono}"
              />
              <WrapPanel ItemSpacing="8" LineSpacing="6">
                <Button
                  x:Name="LogChooseFolderButton"
                  Content="{l:T Logging.ChooseFolder}"
                  Command="{Binding Logging.ChooseFolderCommand, FallbackValue={x:Null}}"
                  IsVisible="{Binding Logging.CanChooseFolder, FallbackValue=False}"
                />
                <Button
                  Content="{l:T Logging.ResetFolder}"
                  Command="{Binding Logging.ResetFolderCommand, FallbackValue={x:Null}}"
                />
              </WrapPanel>
              <TextBlock
                Text="{l:T Logging.FileHelp}"
                Foreground="{DynamicResource Brush.TextMuted}"
                TextWrapping="Wrap"
              />
              <WrapPanel ItemSpacing="12" LineSpacing="8">
                <StackPanel Spacing="4">
                  <TextBlock Text="{l:T Logging.MaxFile}" Foreground="{DynamicResource Brush.TextMuted}" />
                  <TextBox
                    x:Name="LogMaxFileBox"
                    Text="{Binding Logging.MaxFileMegabytes, FallbackValue=''}"
                    AutomationProperties.Name="{l:T Logging.MaxFile}"
                    MinWidth="96"
                  />
                </StackPanel>
                <StackPanel Spacing="4">
                  <TextBlock Text="{l:T Logging.KeepDays}" Foreground="{DynamicResource Brush.TextMuted}" />
                  <TextBox
                    x:Name="LogKeepDaysBox"
                    Text="{Binding Logging.KeepDays, FallbackValue=''}"
                    AutomationProperties.Name="{l:T Logging.KeepDays}"
                    MinWidth="96"
                  />
                </StackPanel>
                <StackPanel Spacing="4">
                  <TextBlock Text="{l:T Logging.Total}" Foreground="{DynamicResource Brush.TextMuted}" />
                  <TextBox
                    x:Name="LogTotalBox"
                    Text="{Binding Logging.TotalMegabytes, FallbackValue=''}"
                    AutomationProperties.Name="{l:T Logging.Total}"
                    MinWidth="96"
                  />
                </StackPanel>
              </WrapPanel>
            </StackPanel>

            <TextBlock Text="{l:T Logging.Otlp}" FontWeight="SemiBold" Margin="0,8,0,0" />
            <TextBlock
              Text="{l:T Logging.Otlp.Help}"
              Foreground="{DynamicResource Brush.TextMuted}"
              TextWrapping="Wrap"
            />
            <TextBlock
              Text="{Binding Logging.EnvironmentTarget, FallbackValue={x:Null}}"
              IsVisible="{Binding Logging.EnvironmentTarget, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}"
              FontFamily="{DynamicResource Font.Mono}"
              TextWrapping="Wrap"
            />
            <ItemsControl x:Name="OtlpTargets" ItemsSource="{Binding Logging.Targets, FallbackValue={x:Null}}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="s:OtlpTargetRow">
                  <Border
                    Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="{DynamicResource Thickness.Border}"
                    CornerRadius="{DynamicResource Radius.Control}"
                    Padding="10,8"
                    Margin="0,0,0,6"
                  >
                    <StackPanel Spacing="4">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                      <TextBlock
                        Text="{Binding Summary}"
                        FontFamily="{DynamicResource Font.Mono}"
                        Foreground="{DynamicResource Brush.TextMuted}"
                        TextWrapping="Wrap"
                      />
                      <WrapPanel ItemSpacing="8">
                        <Button Content="{l:T Logging.EditTarget}" Command="{Binding EditCommand}" />
                        <Button Content="{l:T Logging.DeleteTarget}" Command="{Binding DeleteCommand}" />
                      </WrapPanel>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button
              x:Name="AddOtlpTargetButton"
              Content="{l:T Logging.AddTarget}"
              Command="{Binding Logging.AddTargetCommand, FallbackValue={x:Null}}"
            />
            <Border
              x:Name="OtlpTargetForm"
              IsVisible="{Binding Logging.IsEditingTarget, FallbackValue=False}"
              Background="{DynamicResource Brush.Surface}"
              BorderBrush="{DynamicResource Brush.Border}"
              BorderThickness="{DynamicResource Thickness.Border}"
              CornerRadius="{DynamicResource Radius.Control}"
              Padding="12"
            >
              <StackPanel Spacing="8">
                <TextBlock Text="{l:T Logging.TargetName}" Foreground="{DynamicResource Brush.TextMuted}" />
                <TextBox
                  x:Name="OtlpNameBox"
                  Text="{Binding Logging.EditName, FallbackValue=''}"
                  AutomationProperties.Name="{l:T Logging.TargetName}"
                />
                <TextBlock Text="{l:T Logging.Endpoint}" Foreground="{DynamicResource Brush.TextMuted}" />
                <TextBox
                  x:Name="OtlpEndpointBox"
                  Text="{Binding Logging.EditEndpoint, FallbackValue=''}"
                  PlaceholderText="{l:T Logging.EndpointExample}"
                  AutomationProperties.Name="{l:T Logging.Endpoint}"
                  FontFamily="{DynamicResource Font.Mono}"
                />
                <TextBlock Text="{l:T Logging.Protocol}" Foreground="{DynamicResource Brush.TextMuted}" />
                <WrapPanel ItemSpacing="12">
                  <RadioButton
                    GroupName="OtlpProtocol"
                    Content="{l:T Logging.Protocol.Grpc}"
                    IsChecked="{Binding Logging.EditGrpc, FallbackValue=True}"
                  />
                  <RadioButton
                    GroupName="OtlpProtocol"
                    Content="{l:T Logging.Protocol.HttpProtobuf}"
                    IsChecked="{Binding !Logging.EditGrpc, FallbackValue=False}"
                  />
                </WrapPanel>
                <TextBlock Text="{l:T Logging.Signals}" Foreground="{DynamicResource Brush.TextMuted}" />
                <WrapPanel ItemSpacing="12">
                  <CheckBox
                    Content="{l:T Logging.Signal.Logs}"
                    IsChecked="{Binding Logging.EditLogs, FallbackValue=True}"
                  />
                  <CheckBox
                    Content="{l:T Logging.Signal.Metrics}"
                    IsChecked="{Binding Logging.EditMetrics, FallbackValue=True}"
                  />
                  <CheckBox
                    Content="{l:T Logging.Signal.Traces}"
                    IsChecked="{Binding Logging.EditTraces, FallbackValue=True}"
                  />
                </WrapPanel>
                <TextBlock Text="{l:T Logging.Headers}" Foreground="{DynamicResource Brush.TextMuted}" />
                <ItemsControl ItemsSource="{Binding Logging.EditHeaders, FallbackValue={x:Null}}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="s:OtlpHeaderRow">
                      <WrapPanel ItemSpacing="8" LineSpacing="4" Margin="0,2">
                        <TextBox
                          Text="{Binding Name}"
                          PlaceholderText="{l:T Logging.HeaderName}"
                          AutomationProperties.Name="{l:T Logging.HeaderName}"
                          MinWidth="160"
                          FontFamily="{DynamicResource Font.Mono}"
                        />
                        <TextBox
                          Text="{Binding Value}"
                          PasswordChar="•"
                          PlaceholderText="{l:T Logging.HeaderValue}"
                          AutomationProperties.Name="{l:T Logging.HeaderValue}"
                          MinWidth="220"
                        />
                        <TextBlock
                          Text="{l:T Logging.HeaderStored}"
                          IsVisible="{Binding HasStoredValue}"
                          Foreground="{DynamicResource Brush.TextMuted}"
                          VerticalAlignment="Center"
                        />
                        <Button Content="{l:T Logging.RemoveHeader}" Command="{Binding RemoveCommand}" />
                      </WrapPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button
                  Content="{l:T Logging.AddHeader}"
                  Command="{Binding Logging.AddHeaderCommand, FallbackValue={x:Null}}"
                />
                <CheckBox
                  Content="{l:T Logging.TargetOnSwitch}"
                  IsChecked="{Binding Logging.EditOn, FallbackValue=True}"
                />
                <WrapPanel ItemSpacing="8">
                  <Button
                    x:Name="OtlpKeepButton"
                    Content="{l:T Logging.KeepTarget}"
                    Command="{Binding Logging.KeepTargetCommand, FallbackValue={x:Null}}"
                  />
                  <Button
                    Content="{l:T Logging.CancelTarget}"
                    Command="{Binding Logging.CancelTargetCommand, FallbackValue={x:Null}}"
                  />
                </WrapPanel>
              </StackPanel>
            </Border>
            <TextBlock
              Text="{l:T Logging.RestartPending}"
              IsVisible="{Binding Logging.RestartPending, FallbackValue=False}"
              Foreground="{DynamicResource Brush.Warn}"
              TextWrapping="Wrap"
            />
            <WrapPanel ItemSpacing="8" LineSpacing="8">
              <Button
                x:Name="LoggingSaveButton"
                Content="{l:T Logging.Save}"
                Command="{Binding Logging.SaveCommand, FallbackValue={x:Null}}"
              />
              <TextBlock Text="{Binding Logging.SavedText, FallbackValue={x:Null}}" VerticalAlignment="Center" />
            </WrapPanel>
            <TextBlock
              Text="{Binding Logging.Error, FallbackValue={x:Null}}"
              IsVisible="{Binding Logging.Error, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}"
              Foreground="{DynamicResource Brush.Warn}"
              TextWrapping="Wrap"
            />
          </StackPanel>
        </Panel>
      </ScrollViewer>
    </DockPanel>
  </DockPanel>
</UserControl>

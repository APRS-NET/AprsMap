<!-- SPDX-License-Identifier: AGPL-3.0-only -->
<!-- The main screen: the status bar, and the shell with the map and panels (F1.0). Colours, sizes and corners come
     only from theme tokens. -->
<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:AprsMap.UI.ViewModels"
  xmlns:c="using:AprsMap.Contracts"
  xmlns:l="using:AprsMap.UI.Localization"
  xmlns:views="using:AprsMap.UI.Views"
  x:Class="AprsMap.UI.Views.MainView"
  x:DataType="vm:MainViewModel"
  Background="{DynamicResource Brush.Ground}"
  Foreground="{DynamicResource Brush.Text}"
  FontSize="{DynamicResource Text.Body}"
>
  <UserControl.Styles>
    <!-- While the engine is away the panels keep what they had, faded as out of date (F1.14 behavior 7). -->
    <Style Selector="DockControl.away">
      <Setter Property="Opacity" Value="{DynamicResource Opacity.Away}" />
    </Style>
    <!-- The narrow layout's tabs use the text tokens, not Fluent's large tab headers, so they follow the text size. -->
    <Style Selector="TabControl#NarrowShell > TabItem">
      <Setter Property="FontSize" Value="{DynamicResource Text.Title}" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="12,6" />
    </Style>
    <!-- A refused login needs the user: the status takes the warning colour, as errors do, on the surface colour the
         contrast checks cover (not the button's own fill). -->
    <!-- The connection pill: its switch and its status button share one outline, coloured by the state. A refused login
         needs the user: the status takes the warning colour, as errors do, on the surface colour the contrast checks
         cover. -->
    <Style Selector="Border#ConnectionPill">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
    </Style>
    <!-- Connected: the OK colours, quiet (F1.1). -->
    <Style Selector="Border#ConnectionPill.ok">
      <Setter Property="Background" Value="{DynamicResource Brush.OkSoft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Ok}" />
    </Style>
    <Style Selector="Border#ConnectionPill.warn">
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Warn}" />
    </Style>
    <Style Selector="Border#ConnectionPill.warn TextBlock#ConnectionLabel">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Warn}" />
    </Style>
  </UserControl.Styles>
  <Panel>
    <DockPanel>
      <Border
        DockPanel.Dock="Top"
        Background="{DynamicResource Brush.Surface}"
        BorderBrush="{DynamicResource Brush.Border}"
        BorderThickness="{DynamicResource Thickness.BorderBottom}"
        Padding="16,10"
      >
        <DockPanel>
          <Button
            x:Name="SettingsButton"
            DockPanel.Dock="Right"
            Command="{Binding OpenSettingsCommand}"
            ToolTip.Tip="{l:T Main.Settings}"
            AutomationProperties.Name="{l:T Main.Settings}"
            VerticalAlignment="Center"
          >
            <!-- An eight-tooth gear, drawn for this app. -->
            <PathIcon
              Data="F0 M 19.85,9.64 L 22.36,10.31 L 22.36,13.69 L 19.85,14.36 L 19.22,15.89 L 20.52,18.13 L 18.13,20.52 L 15.89,19.22 L 14.36,19.85 L 13.69,22.36 L 10.31,22.36 L 9.64,19.85 L 8.11,19.22 L 5.87,20.52 L 3.48,18.13 L 4.78,15.89 L 4.15,14.36 L 1.64,13.69 L 1.64,10.31 L 4.15,9.64 L 4.78,8.11 L 3.48,5.87 L 5.87,3.48 L 8.11,4.78 L 9.64,4.15 L 10.31,1.64 L 13.69,1.64 L 14.36,4.15 L 15.89,4.78 L 18.13,3.48 L 20.52,5.87 L 19.22,8.11 Z M 15.40,12 A 3.4,3.4 0 1 0 8.60,12 A 3.4,3.4 0 1 0 15.40,12 Z"
              Width="{DynamicResource Icon.Size}"
              Height="{DynamicResource Icon.Size}"
            />
          </Button>
          <!-- The app menu (F1.0): closed panels, Reset layout, Gather windows. Built when it opens (code-behind). -->
          <Button
            x:Name="AppMenuButton"
            DockPanel.Dock="Right"
            ToolTip.Tip="{l:T Shell.Menu}"
            AutomationProperties.Name="{l:T Shell.Menu}"
            VerticalAlignment="Center"
            Margin="0,0,8,0"
          >
            <PathIcon
              Data="M 3,6 L 21,6 L 21,8 L 3,8 Z M 3,11 L 21,11 L 21,13 L 3,13 Z M 3,16 L 21,16 L 21,18 L 3,18 Z"
              Width="{DynamicResource Icon.Size}"
              Height="{DynamicResource Icon.Size}"
            />
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedRight" />
            </Button.Flyout>
          </Button>
          <!-- After a gateway upgrade: this page is older than the gateway (F1.14 behavior 8). -->
          <DockPanel x:Name="OutdatedBar" DockPanel.Dock="Bottom" IsVisible="{Binding IsOutdated}" Margin="0,6,0,0">
            <Button
              x:Name="ReloadButton"
              DockPanel.Dock="Right"
              Classes="accent"
              Content="{l:T Shell.Reload}"
              Command="{Binding ReloadCommand}"
              VerticalAlignment="Center"
            />
            <TextBlock
              Text="{l:T Shell.Outdated}"
              Foreground="{DynamicResource Brush.Warn}"
              TextWrapping="Wrap"
              VerticalAlignment="Center"
            />
          </DockPanel>
          <!-- Said once when the saved layout couldn't be read (F1.0 behavior 10). -->
          <DockPanel
            x:Name="LayoutNoticeBar"
            DockPanel.Dock="Bottom"
            IsVisible="{Binding LayoutNotice, Converter={x:Static ObjectConverters.IsNotNull}}"
            Margin="0,6,0,0"
          >
            <Button
              x:Name="DismissLayoutNotice"
              DockPanel.Dock="Right"
              Content="{l:T Shell.Dismiss}"
              Command="{Binding DismissLayoutNoticeCommand}"
              VerticalAlignment="Center"
            />
            <TextBlock
              Text="{Binding LayoutNotice}"
              Foreground="{DynamicResource Brush.Warn}"
              TextWrapping="Wrap"
              VerticalAlignment="Center"
            />
          </DockPanel>
          <!-- Its own line, wrapping: an error can be long, and the status items must stay in the window. -->
          <TextBlock
            x:Name="ErrorLabel"
            DockPanel.Dock="Bottom"
            Text="{Binding ErrorText}"
            IsVisible="{Binding ErrorText, Converter={x:Static ObjectConverters.IsNotNull}}"
            Foreground="{DynamicResource Brush.Warn}"
            TextWrapping="Wrap"
            Margin="0,6,0,0"
          />
          <!-- Wraps onto more lines at large text sizes or in a narrow window rather than running off it. -->
          <WrapPanel ItemSpacing="16" LineSpacing="6">
            <TextBlock
              Text="{Binding Title}"
              FontSize="{DynamicResource Text.Title}"
              FontWeight="SemiBold"
              VerticalAlignment="Center"
            />
            <ComboBox
              x:Name="ProfilePicker"
              ItemsSource="{Binding Profiles}"
              SelectedItem="{Binding SelectedProfile}"
              IsEnabled="{Binding CanSwitchProfiles}"
              IsVisible="{Binding !!Profiles.Count}"
              VerticalAlignment="Center"
              ToolTip.Tip="{l:T Main.ProfilePicker.ToolTip}"
            >
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="c:StationProfile">
                  <TextBlock>
                    <Run Text="{Binding Name}" />
                    <Run
                      Text="{Binding Callsign}"
                      Foreground="{DynamicResource Brush.TextMuted}"
                      FontFamily="{DynamicResource Font.Mono}"
                    />
                  </TextBlock>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <!-- The connection pill: the APRS-IS switch on its left (F1.15), then the status, which opens a menu with
                 Reconnect now (F1.1 behavior 7); its tooltip has the details. -->
            <Border
              x:Name="ConnectionPill"
              Classes.warn="{Binding IsConnectionWarning}"
              Classes.ok="{Binding IsConnected}"
              CornerRadius="{DynamicResource Radius.Control}"
              BorderThickness="{DynamicResource Thickness.Border}"
              VerticalAlignment="Center"
            >
              <StackPanel Orientation="Horizontal">
                <ToggleSwitch
                  x:Name="AprsIsSwitch"
                  DataContext="{Binding AprsIsSwitch}"
                  x:DataType="vm:SourceSwitch"
                  IsChecked="{Binding IsOn}"
                  IsEnabled="{Binding CanChange}"
                  OnContent="{x:Null}"
                  OffContent="{x:Null}"
                  MinWidth="0"
                  Margin="8,0,0,0"
                  VerticalAlignment="Center"
                  ToolTip.Tip="{l:T Toggles.Switch.AprsIs}"
                  AutomationProperties.Name="{l:T Toggles.Switch.AprsIs}"
                />
                <Button
                  x:Name="ConnectionButton"
                  Background="{Binding #ConnectionPill.Background}"
                  BorderThickness="0"
                  CornerRadius="{DynamicResource Radius.Control}"
                  Padding="6,4,10,4"
                  VerticalAlignment="Center"
                  ToolTip.Tip="{Binding ConnectionDetails}"
                  AutomationProperties.Name="{l:T Status.Menu}"
                  AutomationProperties.HelpText="{Binding ConnectionText}"
                >
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <!-- Receive-only (an unverified login): an eye, as in "can look, can't send". -->
                    <PathIcon
                      x:Name="ReceiveOnlyIcon"
                      IsVisible="{Binding IsReceiveOnly}"
                      Data="F0 M 12,5 C 6.5,5 2.7,9.4 1.5,12 C 2.7,14.6 6.5,19 12,19 C 17.5,19 21.3,14.6 22.5,12 C 21.3,9.4 17.5,5 12,5 Z M 12,7 C 16,7 19,10 20.3,12 C 19,14 16,17 12,17 C 8,17 5,14 3.7,12 C 5,10 8,7 12,7 Z M 12,8.5 A 3.5,3.5 0 1 0 12,15.5 A 3.5,3.5 0 1 0 12,8.5 Z"
                      Width="{DynamicResource Icon.Size}"
                      Height="{DynamicResource Icon.Size}"
                      ToolTip.Tip="{l:T Status.ReceiveOnly}"
                      AutomationProperties.Name="{l:T Status.ReceiveOnly}"
                    />
                    <TextBlock x:Name="ConnectionLabel" Text="{Binding ConnectionText}" TextWrapping="Wrap" />
                  </StackPanel>
                  <Button.Flyout>
                    <MenuFlyout>
                      <MenuItem
                        x:Name="ReconnectItem"
                        Header="{l:T Status.Reconnect}"
                        Command="{Binding ReconnectCommand}"
                      />
                      <Separator />
                      <!-- Quick toggles (F1.15): the station's, so read-only for a gateway's viewers. -->
                      <MenuItem
                        x:Name="InternetToggle"
                        Header="{l:T Toggles.Internet}"
                        ToggleType="CheckBox"
                        IsChecked="{Binding InternetOn, Mode=OneWay}"
                        IsEnabled="{Binding CanToggle}"
                        Command="{Binding ToggleCommand}"
                        CommandParameter="{x:Static c:Toggle.Internet}"
                      />
                      <MenuItem
                        x:Name="AprsIsToggle"
                        Header="{l:T Toggles.AprsIs}"
                        ToggleType="CheckBox"
                        IsChecked="{Binding AprsIsOn, Mode=OneWay}"
                        IsEnabled="{Binding CanToggleDependents}"
                        Command="{Binding ToggleCommand}"
                        CommandParameter="{x:Static c:Toggle.AprsIs}"
                      />
                      <MenuItem
                        x:Name="TilesToggle"
                        Header="{l:T Toggles.Tiles}"
                        ToggleType="CheckBox"
                        IsChecked="{Binding TilesOn, Mode=OneWay}"
                        IsEnabled="{Binding CanToggleDependents}"
                        Command="{Binding ToggleCommand}"
                        CommandParameter="{x:Static c:Toggle.Tiles}"
                      />
                    </MenuFlyout>
                  </Button.Flyout>
                </Button>
              </StackPanel>
            </Border>
            <!-- A marker per toggle that is off, with its name, never colour alone (F1.15 behavior 4). -->
            <ItemsControl x:Name="ToggleMarkers" ItemsSource="{Binding ToggleMarkers}" VerticalAlignment="Center">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel ItemSpacing="8" LineSpacing="6" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <Button
                    Classes="toggle-marker"
                    BorderBrush="{DynamicResource Brush.Warn}"
                    BorderThickness="{DynamicResource Thickness.Border}"
                    CornerRadius="{DynamicResource Radius.Control}"
                    Padding="8,3"
                    ToolTip.Tip="{l:T Toggles.Marker.Help}"
                    AutomationProperties.Name="{Binding}"
                  >
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <!-- A switch turned off, drawn for this app. -->
                      <PathIcon
                        Data="F0 M 7,7 L 17,7 A 5,5 0 0 1 17,17 L 7,17 A 5,5 0 0 1 7,7 Z M 7,9 A 3,3 0 1 0 7,15 A 3,3 0 1 0 7,9 Z"
                        Width="{DynamicResource Icon.Size}"
                        Height="{DynamicResource Icon.Size}"
                      />
                      <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock
              x:Name="ToggleAnnouncement"
              Text="{Binding ToggleAnnouncement}"
              AutomationProperties.LiveSetting="Polite"
              Width="0"
              Height="0"
              Opacity="0"
            />
            <!-- One pill per source besides APRS-IS, with its own state (F1.25 behavior 11). -->
            <ItemsControl x:Name="SourcePills" ItemsSource="{Binding SourcePills}" VerticalAlignment="Center">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel ItemSpacing="8" LineSpacing="6" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <Border
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="{DynamicResource Thickness.Border}"
                    CornerRadius="{DynamicResource Radius.Control}"
                    Padding="10,4"
                  >
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock
              x:Name="PacketCountLabel"
              Text="{Binding PacketCountText}"
              Foreground="{DynamicResource Brush.TextMuted}"
              VerticalAlignment="Center"
            />
            <TextBlock
              x:Name="StationCountLabel"
              Text="{Binding StationCountText}"
              Foreground="{DynamicResource Brush.TextMuted}"
              VerticalAlignment="Center"
            />
            <Button
              x:Name="OpenSetupButton"
              Content="{l:T Main.Setup.Open}"
              Command="{Binding OpenSetupCommand}"
              IsVisible="{Binding CanOpenSetup}"
              Classes="accent"
              VerticalAlignment="Center"
            />
            <TextBlock
              x:Name="GatewaySetupNote"
              Text="{l:T Main.Setup.GatewayNote}"
              IsVisible="{Binding ShowGatewaySetupNote}"
              Foreground="{DynamicResource Brush.TextMuted}"
              VerticalAlignment="Center"
            />
          </WrapPanel>
        </DockPanel>
      </Border>
      <!-- The map and the panels around it (F1.0). Dock is only used here and in AprsMap.UI/Shell. In a narrow window
           the panels are fixed tabs instead (behavior 7), built by code-behind; the docked layout is kept meanwhile. -->
      <Panel>
        <TabControl x:Name="NarrowShell" IsVisible="False" />
        <DockControl
          x:Name="ShellDock"
          Classes.away="{Binding IsEngineAway}"
          Layout="{Binding Shell.Layout}"
          Factory="{Binding Shell.Factory}"
          InitializeLayout="False"
          InitializeFactory="False"
        >
          <DockControl.DataTemplates>
            <views:PanelTemplate />
          </DockControl.DataTemplates>
        </DockControl>
      </Panel>
    </DockPanel>
    <views:SettingsView
      x:Name="SettingsPage"
      DataContext="{Binding Settings}"
      IsVisible="{Binding $self.DataContext, Converter={x:Static ObjectConverters.IsNotNull}}"
    />
    <views:SetupWizardView
      x:Name="SetupWizard"
      DataContext="{Binding Setup}"
      IsVisible="{Binding $self.DataContext, Converter={x:Static ObjectConverters.IsNotNull}}"
    />
  </Panel>
</UserControl>

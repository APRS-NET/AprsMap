<!-- First cut of the main screen: status bar and live packet list. The map, rail and panes from the approved mockups
     (docs/ux/mockups) replace this as features land. Colours, sizes and corners come only from theme tokens. -->
<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="using:AprsMap.UI.ViewModels"
  xmlns:c="using:AprsMap.Contracts"
  x:Class="AprsMap.UI.Views.MainView"
  x:DataType="vm:MainViewModel"
  Background="{DynamicResource Brush.Ground}"
  Foreground="{DynamicResource Brush.Text}"
  FontSize="{DynamicResource Text.Body}"
>
  <DockPanel>
    <Border
      DockPanel.Dock="Top"
      Background="{DynamicResource Brush.Surface}"
      BorderBrush="{DynamicResource Brush.Border}"
      BorderThickness="0,0,0,1"
      Padding="16,10"
    >
      <StackPanel Orientation="Horizontal" Spacing="16">
        <TextBlock
          Text="{Binding Title}"
          FontSize="{DynamicResource Text.Title}"
          FontWeight="SemiBold"
          VerticalAlignment="Center"
        />
        <Border
          CornerRadius="{DynamicResource Radius.Control}"
          BorderBrush="{DynamicResource Brush.Border}"
          BorderThickness="1"
          Padding="10,4"
        >
          <TextBlock x:Name="ConnectionLabel" Text="{Binding ConnectionText}" />
        </Border>
        <TextBlock Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center">
          <Run Text="{Binding PacketCount}" />
          <Run Text="packets" />
        </TextBlock>
      </StackPanel>
    </Border>
    <ListBox x:Name="PacketList" ItemsSource="{Binding Packets}" Background="{DynamicResource Brush.Surface}">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="c:PacketView">
          <Grid ColumnDefinitions="110,*">
            <TextBlock Text="{Binding Source}" FontFamily="{DynamicResource Font.Mono}" FontWeight="SemiBold" />
            <TextBlock Grid.Column="1" Text="{Binding Summary}" TextTrimming="CharacterEllipsis" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>

<!-- Dock's serializer source generator writes this class into this assembly (Shell/LayoutFile.cs). Its object-payload
     converter calls JsonSerializer with the generated options, whose resolver only knows the registered Dock types, so
     it is trim-safe in practice; the class isn't partial, so the suppression can't be an attribute in code. Only these
     two methods are covered: any other trim warning in this assembly still fails the browser build. -->
<linker>
  <assembly fullname="AprsMap.UI">
    <type fullname="Dock.Serializer.SystemTextJson.DockSystemTextJsonResolver/ObjectPayloadConverter">
      <method name="Read">
        <attribute fullname="System.Diagnostics.CodeAnalysis.UnconditionalSuppressMessageAttribute">
          <argument>Trimming</argument>
          <argument>IL2026</argument>
          <property name="Justification">Generated by Dock: payload types are the registered Dock types only.</property>
        </attribute>
      </method>
      <method name="Write">
        <attribute fullname="System.Diagnostics.CodeAnalysis.UnconditionalSuppressMessageAttribute">
          <argument>Trimming</argument>
          <argument>IL2026</argument>
          <property name="Justification">Generated by Dock: payload types are the registered Dock types only.</property>
        </attribute>
      </method>
    </type>
  </assembly>
</linker>

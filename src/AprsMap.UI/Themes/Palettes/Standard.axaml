<!-- The default quiet palette (docs/ux/README.md#visual-style): muted neutrals, one blue accent, burnt orange reserved for transmitting. Text meets WCAG AA (4.5:1).
     One of three palettes AppearanceService swaps in; each defines every Color.* token for Light and Dark, and the
     border widths. Brushes and sizes live in ../Tokens.axaml. -->
<ResourceDictionary
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  x:Class="AprsMap.UI.Themes.Palettes.StandardPalette"
>
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <Color x:Key="Color.Ground">#F4F5F7</Color>
      <Color x:Key="Color.Surface">#FFFFFF</Color>
      <Color x:Key="Color.Border">#DCE0E6</Color>
      <Color x:Key="Color.Text">#16191D</Color>
      <Color x:Key="Color.TextMuted">#5A6270</Color>
      <Color x:Key="Color.Accent">#1F5FAE</Color>
      <Color x:Key="Color.AccentSoft">#E6EEF8</Color>
      <Color x:Key="Color.Transmit">#C2410C</Color>
      <Color x:Key="Color.Ok">#1E7A4C</Color>
      <Color x:Key="Color.OkSoft">#E3F3EA</Color>
      <Color x:Key="Color.Warn">#B45309</Color>
      <Color x:Key="Color.Track">#7B3F98</Color>
      <Color x:Key="Color.Area1">#3A3F45</Color>
      <Color x:Key="Color.Area2">#2160C4</Color>
      <Color x:Key="Color.Area3">#2E7D3E</Color>
      <Color x:Key="Color.Area4">#137F91</Color>
      <Color x:Key="Color.Area5">#C53030</Color>
      <Color x:Key="Color.Area6">#7E3FB0</Color>
      <Color x:Key="Color.Area7">#9A6B00</Color>
      <Color x:Key="Color.Area8">#5F6673</Color>
      <Color x:Key="Color.Scrim">#6616191D</Color>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <Color x:Key="Color.Ground">#15181C</Color>
      <Color x:Key="Color.Surface">#1D2126</Color>
      <Color x:Key="Color.Border">#323840</Color>
      <Color x:Key="Color.Text">#E6E9ED</Color>
      <Color x:Key="Color.TextMuted">#A3ABB6</Color>
      <Color x:Key="Color.Accent">#7FA7DA</Color>
      <Color x:Key="Color.AccentSoft">#24334A</Color>
      <Color x:Key="Color.Transmit">#E08A5C</Color>
      <Color x:Key="Color.Ok">#6FBF93</Color>
      <Color x:Key="Color.OkSoft">#1F3B2D</Color>
      <Color x:Key="Color.Warn">#D9A15B</Color>
      <Color x:Key="Color.Track">#C9A0DC</Color>
      <Color x:Key="Color.Area1">#C9CED6</Color>
      <Color x:Key="Color.Area2">#7FA7E8</Color>
      <Color x:Key="Color.Area3">#6FC48A</Color>
      <Color x:Key="Color.Area4">#5CC3D3</Color>
      <Color x:Key="Color.Area5">#F07D7D</Color>
      <Color x:Key="Color.Area6">#C39AE8</Color>
      <Color x:Key="Color.Area7">#E8C35C</Color>
      <Color x:Key="Color.Area8">#A3ABB6</Color>
      <Color x:Key="Color.Scrim">#99000000</Color>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <Thickness x:Key="Thickness.Border">1</Thickness>
  <Thickness x:Key="Thickness.BorderBottom">0,0,0,1</Thickness>
</ResourceDictionary>

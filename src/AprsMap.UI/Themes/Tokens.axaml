<!-- Design tokens: with Palettes/, the only place colours live. Views reference these keys with DynamicResource, never literal values,
     so theme, palette, size and corner options apply live (docs/ux/README.md#appearance-and-accessibility).
     Quiet palette by intent: muted neutrals, one blue accent, burnt orange reserved for transmitting. -->
<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- The Color.* tokens come from the palette in Palettes/ (Standard by default; AppearanceService swaps it). -->

  <SolidColorBrush x:Key="Brush.Ground" Color="{DynamicResource Color.Ground}" />
  <SolidColorBrush x:Key="Brush.Surface" Color="{DynamicResource Color.Surface}" />
  <SolidColorBrush x:Key="Brush.Border" Color="{DynamicResource Color.Border}" />
  <SolidColorBrush x:Key="Brush.Text" Color="{DynamicResource Color.Text}" />
  <SolidColorBrush x:Key="Brush.TextMuted" Color="{DynamicResource Color.TextMuted}" />
  <SolidColorBrush x:Key="Brush.Accent" Color="{DynamicResource Color.Accent}" />
  <SolidColorBrush x:Key="Brush.AccentSoft" Color="{DynamicResource Color.AccentSoft}" />
  <SolidColorBrush x:Key="Brush.Transmit" Color="{DynamicResource Color.Transmit}" />
  <SolidColorBrush x:Key="Brush.Ok" Color="{DynamicResource Color.Ok}" />
  <SolidColorBrush x:Key="Brush.Warn" Color="{DynamicResource Color.Warn}" />
  <!-- Dims what is behind a dialog. Plain translucent, never blurred. -->
  <SolidColorBrush x:Key="Brush.Scrim" Color="{DynamicResource Color.Scrim}" />

  <!-- Size and shape tokens. AppearanceService overwrites these at runtime for text size, icon size and corners. -->
  <x:Double x:Key="Text.Body">14</x:Double>
  <x:Double x:Key="Text.Small">12.5</x:Double>
  <x:Double x:Key="Text.Title">17</x:Double>
  <x:Double x:Key="Icon.Size">20</x:Double>
  <!-- List rows: Comfortable; AppearanceService switches density (and Fluent's own DensityStyle). -->
  <Thickness x:Key="Space.ListItem">12,8</Thickness>
  <x:Double x:Key="Size.ListItemMinHeight">36</x:Double>
  <!-- Transitions; 0 when motion is reduced (F0.6 behavior 12). -->
  <x:TimeSpan x:Key="Motion.Duration">0:0:0.15</x:TimeSpan>
  <CornerRadius x:Key="Radius.Control">8</CornerRadius>
  <CornerRadius x:Key="Radius.Panel">12</CornerRadius>
  <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace</FontFamily>
</ResourceDictionary>

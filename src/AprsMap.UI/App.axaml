<Application
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  x:Class="AprsMap.UI.App"
  RequestedThemeVariant="Default"
>
  <Application.Styles>
    <FluentTheme />
    <!-- List rows follow the density tokens. -->
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="{DynamicResource Space.ListItem}" />
      <Setter Property="MinHeight" Value="{DynamicResource Size.ListItemMinHeight}" />
    </Style>
  </Application.Styles>
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- First: the palette, which AppearanceService replaces (it must stay at index 0). -->
        <ResourceInclude Source="avares://AprsMap.UI/Themes/Palettes/Standard.axaml" />
        <ResourceInclude Source="avares://AprsMap.UI/Themes/Tokens.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>

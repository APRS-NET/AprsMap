<Application
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:dock="using:Dock.Avalonia.Themes.Fluent"
  x:Class="AprsMap.UI.App"
  RequestedThemeVariant="Default"
>
  <Application.Styles>
    <FluentTheme />
    <dock:DockFluentTheme />
    <!-- Panel tabs wrap onto another row instead of running off the panel at large text sizes. -->
    <Style Selector="ToolTabStrip">
      <Setter Property="ItemsPanel">
        <ItemsPanelTemplate>
          <WrapPanel />
        </ItemsPanelTemplate>
      </Setter>
    </Style>
    <Style Selector="ToolTabStrip /template/ ScrollViewer#PART_ScrollViewer">
      <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>
    <!-- On a touch screen, every target is at least 44 × 44 px whatever the density (F0.6 behavior 11, WCAG 2.5.5). The
         app sets the "touch" class on its root view when the platform's primary pointer is coarse. -->
    <Style Selector=".touch :is(Button)">
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="MinWidth" Value="44" />
    </Style>
    <Style Selector=".touch ComboBox, .touch TextBox, .touch ListBoxItem">
      <Setter Property="MinHeight" Value="44" />
    </Style>
    <!-- List rows follow the density tokens. -->
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="{DynamicResource Space.ListItem}" />
      <Setter Property="MinHeight" Value="{DynamicResource Size.ListItemMinHeight}" />
    </Style>
  </Application.Styles>
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- First: the palette, which AppearanceService replaces (it must stay at index 0). -->
        <ResourceInclude Source="avares://AprsMap.UI/Themes/Palettes/Standard.axaml" />
        <ResourceInclude Source="avares://AprsMap.UI/Themes/Tokens.axaml" />
        <ResourceInclude Source="avares://AprsMap.UI/Themes/DockTokens.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>

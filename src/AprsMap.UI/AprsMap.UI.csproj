<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AprsMapUsesAvalonia>true</AprsMapUsesAvalonia>
    <Description>Shared Avalonia views, view models and themes for the desktop and browser apps.</Description>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AprsMap.UI.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The window icon; generated from build/branding/icon.svg by tools/make-icons.sh (docs/branding.md). -->
    <AvaloniaResource Include="../../build/branding/icon-256.png" Link="Assets/icon.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- The UI sees only the contract, never the engine, so the browser app (over SignalR) and the desktop app
         (in-process) get exactly the same views. -->
    <ProjectReference Include="../AprsMap.Contracts/AprsMap.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <!-- Docking (F1.0). Only AprsMap.UI/Shell uses it, so it could be replaced by rewriting the shell alone. -->
    <PackageReference Include="Dock.Avalonia" />
    <PackageReference Include="Dock.Avalonia.Themes.Fluent" />
    <PackageReference Include="Dock.Model.Mvvm" />
    <PackageReference Include="Dock.Serializer.SystemTextJson" />
    <PackageReference Include="MessageFormat" />
  </ItemGroup>
  <ItemGroup>
    <!-- Trim suppressions for code Dock's source generator writes into this assembly (see the file). -->
    <EmbeddedResource Include="ILLink.LinkAttributes.xml" LogicalName="ILLink.LinkAttributes.xml" />
  </ItemGroup>
</Project>

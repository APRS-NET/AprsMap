<!-- The map panel (F1.4): the map, its buttons (Home, zoom) over the top-right corner, and the tile provider's
     attribution, linked as the provider requires, over the bottom-right corner. Colours and sizes come from tokens. -->
<UserControl
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:l="using:AprsMap.UI.Localization"
  xmlns:vm="using:AprsMap.UI.ViewModels"
  x:Class="AprsMap.UI.Map.MapPanel"
  x:DataType="vm:MainViewModel"
>
  <UserControl.Resources>
    <ContextMenu x:Key="MapMenu" x:Name="MapMenu">
      <MenuItem x:Name="SetMyLocationItem" Header="{l:T Map.SetMyLocation}" />
    </ContextMenu>
  </UserControl.Resources>
  <Panel>
    <Border x:Name="MapHost" />
    <!-- After Set my location here: what happened, and Undo for 10 s (F1.13 behavior 2). -->
    <Border
      x:Name="LocationNotice"
      HorizontalAlignment="Left"
      VerticalAlignment="Bottom"
      Background="{DynamicResource Brush.Surface}"
      BorderBrush="{DynamicResource Brush.Border}"
      BorderThickness="{DynamicResource Thickness.Border}"
      CornerRadius="{DynamicResource Radius.Control}"
      Padding="10,4"
      Margin="10"
      IsVisible="{Binding CanUndoMyLocation}"
    >
      <StackPanel Orientation="Horizontal" Spacing="10">
        <TextBlock Text="{Binding MyLocationNotice}" VerticalAlignment="Center" />
        <Button
          x:Name="UndoLocationButton"
          Content="{l:T Map.UndoLocation}"
          Command="{Binding UndoMyLocationCommand}"
        />
      </StackPanel>
    </Border>
    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" Spacing="6">
      <Button
        x:Name="ZoomInButton"
        ToolTip.Tip="{l:T Map.ZoomIn}"
        AutomationProperties.Name="{l:T Map.ZoomIn}"
        Background="{DynamicResource Brush.Surface}"
        BorderBrush="{DynamicResource Brush.Border}"
        BorderThickness="{DynamicResource Thickness.Border}"
      >
        <PathIcon
          Data="M 11,5 L 13,5 L 13,11 L 19,11 L 19,13 L 13,13 L 13,19 L 11,19 L 11,13 L 5,13 L 5,11 L 11,11 Z"
          Width="{DynamicResource Icon.Size}"
          Height="{DynamicResource Icon.Size}"
        />
      </Button>
      <Button
        x:Name="ZoomOutButton"
        ToolTip.Tip="{l:T Map.ZoomOut}"
        AutomationProperties.Name="{l:T Map.ZoomOut}"
        Background="{DynamicResource Brush.Surface}"
        BorderBrush="{DynamicResource Brush.Border}"
        BorderThickness="{DynamicResource Thickness.Border}"
      >
        <PathIcon
          Data="M 5,11 L 19,11 L 19,13 L 5,13 Z"
          Width="{DynamicResource Icon.Size}"
          Height="{DynamicResource Icon.Size}"
        />
      </Button>
      <Button
        x:Name="FitButton"
        ToolTip.Tip="{l:T Map.Fit}"
        AutomationProperties.Name="{l:T Map.Fit}"
        Background="{DynamicResource Brush.Surface}"
        BorderBrush="{DynamicResource Brush.Border}"
        BorderThickness="{DynamicResource Thickness.Border}"
      >
        <!-- Four corners pointing out: fit everything in view. -->
        <PathIcon
          Data="M 4,4 L 10,4 L 10,6 L 6,6 L 6,10 L 4,10 Z M 14,4 L 20,4 L 20,10 L 18,10 L 18,6 L 14,6 Z M 4,14 L 6,14 L 6,18 L 10,18 L 10,20 L 4,20 Z M 18,14 L 20,14 L 20,20 L 14,20 L 14,18 L 18,18 Z"
          Width="{DynamicResource Icon.Size}"
          Height="{DynamicResource Icon.Size}"
        />
      </Button>
      <Button
        x:Name="HomeButton"
        ToolTip.Tip="{l:T Map.Home}"
        AutomationProperties.Name="{l:T Map.Home}"
        Background="{DynamicResource Brush.Surface}"
        BorderBrush="{DynamicResource Brush.Border}"
        BorderThickness="{DynamicResource Thickness.Border}"
      >
        <!-- A house, drawn for this app. -->
        <PathIcon
          Data="M 12,3 L 21,11 L 18,11 L 18,20 L 14,20 L 14,14 L 10,14 L 10,20 L 6,20 L 6,11 L 3,11 Z"
          Width="{DynamicResource Icon.Size}"
          Height="{DynamicResource Icon.Size}"
        />
      </Button>
    </StackPanel>
    <Border
      x:Name="AttributionBar"
      HorizontalAlignment="Right"
      VerticalAlignment="Bottom"
      Background="{DynamicResource Brush.Surface}"
      Opacity="0.9"
      Padding="6,2"
      CornerRadius="{DynamicResource Radius.Control}"
      Margin="4"
    >
      <HyperlinkButton
        x:Name="AttributionLink"
        Padding="0"
        FontSize="{DynamicResource Text.Small}"
        Foreground="{DynamicResource Brush.Text}"
      />
    </Border>
  </Panel>
</UserControl>

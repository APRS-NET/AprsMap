<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <!-- Help › About lists the components this app is built from (F1.34). -->
    <AprsMapEmbedComponents>true</AprsMapEmbedComponents>
    <AprsMapComponentHost>Gateway</AprsMapComponentHost>
    <Description>The web gateway: hosts the engine, serves the browser app and exposes IEngineService over SignalR.</Description>
    <AssemblyName>$(ProductSlug)-gateway</AssemblyName>
    <!-- Container image settings for 'dotnet publish /t:PublishContainer'. The Dockerfile is the primary path because
         the browser app needs the wasm-tools workload at build time. -->
    <ContainerRepository>$(ProductSlug)</ContainerRepository>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AprsMap.Gateway.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../AprsMap.Server/AprsMap.Server.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
  </ItemGroup>
</Project>

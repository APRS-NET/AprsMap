<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Help › About lists the components this app is built from (F1.34). -->
    <AprsMapEmbedComponents>true</AprsMapEmbedComponents>
    <AprsMapComponentHost>Desktop</AprsMapComponentHost>
    <OutputType>WinExe</OutputType>
    <AprsMapUsesAvalonia>true</AprsMapUsesAvalonia>
    <AssemblyName>$(ProductSlug)</AssemblyName>
    <!-- The executable's icon on Windows; generated from build/branding/icon.svg by tools/make-icons.sh. -->
    <ApplicationIcon>../../build/branding/icon.ico</ApplicationIcon>
    <Description>The standalone desktop app (Windows, Linux, macOS). Runs the engine in-process.</Description>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../AprsMap.UI/AprsMap.UI.csproj" />
    <ProjectReference Include="../AprsMap.Hosting/AprsMap.Hosting.csproj" />
    <!-- The web viewer (F1.35): the gateway's server parts, run around the desktop's own engine. -->
    <ProjectReference Include="../AprsMap.Server/AprsMap.Server.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Velopack" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- The applications menu's icon for an installed AppImage (LinuxDesktopEntry). -->
    <EmbeddedResource Include="../../build/branding/icon-256.png" LogicalName="icon-256.png" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AprsMapUsesAvalonia>true</AprsMapUsesAvalonia>
    <AssemblyName>$(ProductSlug)</AssemblyName>
    <!-- The executable's icon on Windows; generated from build/branding/icon.svg by tools/make-icons.sh. -->
    <ApplicationIcon>../../build/branding/icon.ico</ApplicationIcon>
    <Description>The standalone desktop app (Windows, Linux, macOS). Runs the engine in-process.</Description>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../AprsMap.UI/AprsMap.UI.csproj" />
    <ProjectReference Include="../AprsMap.Hosting/AprsMap.Hosting.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

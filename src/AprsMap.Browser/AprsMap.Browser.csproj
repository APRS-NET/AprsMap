<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0-browser</TargetFramework>
    <OutputType>Exe</OutputType>
    <AprsMapUsesAvalonia>true</AprsMapUsesAvalonia>
    <Description>The web app: the shared UI compiled to WebAssembly, talking to the gateway over SignalR.</Description>
    <!-- SkiaSharp and HarfBuzz are native libraries that must be linked into dotnet.wasm, which needs the wasm-tools
         workload. Only publishing does that (CI and the Dockerfile install the workload), so a plain local build works
         on any SDK; the output of a plain build does not render. -->
    <WasmBuildNative Condition="'$(_IsPublishing)' == 'true'">true</WasmBuildNative>
    <!-- Release publishes are compiled ahead of time (F1.4 decision 1): with 2,000 stations the interpreter draws about
         8 frames a second while panning, and AOT about 28. It adds about five minutes to a publish. -->
    <RunAOTCompilation Condition="'$(Configuration)' == 'Release'">true</RunAOTCompilation>
    <!-- The JSImport source generator (StartupPage) emits unsafe marshalling code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../AprsMap.UI/AprsMap.UI.csproj" />
    <ProjectReference Include="../AprsMap.Client.Remote/AprsMap.Client.Remote.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Browser" />
  </ItemGroup>

  <!-- Trimming (F1.0 implementation notes). Every assembly reports its trim warnings one by one, and they fail the
       build, except the three Dock assemblies named here: Dock's themes use reflection bindings, and its serializer uses
       generic JSON calls, so for each of them the trimmer prints one summary warning (IL2104), which is allowed. A
       browser smoke test covers what those code paths drive (splitter, tab move, float, layout save and restore), and
       the exception goes once Dock switches to compiled bindings upstream. _ExtraTrimmerArgs is the SDK's way to pass
       trimmer options; per-assembly TrimmerSingleWarn metadata isn't applied to package assemblies. -->
  <PropertyGroup>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);IL2104</WarningsNotAsErrors>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <_ExtraTrimmerArgs>$(_ExtraTrimmerArgs) --singlewarn Dock.Avalonia --singlewarn Dock.Avalonia.Themes.Fluent --singlewarn Dock.Serializer.SystemTextJson</_ExtraTrimmerArgs>
  </PropertyGroup>
</Project>

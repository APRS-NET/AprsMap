<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>The server parts shared by the gateway and the desktop's web viewer: the engine hub, the browser app's files, tiles, viewers and operator sign-in.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="$(ProductSlug)-gateway" />
    <InternalsVisibleTo Include="AprsMap.Gateway.Tests" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- What the Web SDK brings in by itself, for code moved here from the gateway. -->
  <ItemGroup>
    <Using Include="System.Net.Http.Json" />
    <Using Include="Microsoft.AspNetCore.Builder" />
    <Using Include="Microsoft.AspNetCore.Hosting" />
    <Using Include="Microsoft.AspNetCore.Http" />
    <Using Include="Microsoft.AspNetCore.Routing" />
    <Using Include="Microsoft.Extensions.Configuration" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Hosting" />
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../AprsMap.Hosting/AprsMap.Hosting.csproj" />
  </ItemGroup>
</Project>

<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup Label="APRS.NET (pre-release until its 1.0; Dependabot proposes each new alpha)">
    <PackageVersion Include="AprsNet.AprsIsTcpClient" Version="0.6.0-alpha.1" />
    <PackageVersion Include="AprsNet.Beacons" Version="0.6.0-alpha.1" />
    <PackageVersion Include="AprsNet.Corpus" Version="0.6.0-alpha.1" />
    <PackageVersion Include="AprsNet.DeviceId" Version="0.6.0-alpha.1" />
    <PackageVersion Include="AprsNet.Filters" Version="0.6.0-alpha.1" />
    <PackageVersion Include="AprsNet.Gps" Version="0.6.0-alpha.1" />
    <PackageVersion Include="AprsNet.IGate" Version="0.6.0-alpha.1" />
    <PackageVersion Include="AprsNet.Kiss" Version="0.6.0-alpha.1" />
    <PackageVersion Include="AprsNet.Kiss.Serial" Version="0.6.0-alpha.1" />
    <PackageVersion Include="AprsNet.Messaging" Version="0.6.0-alpha.1" />
    <PackageVersion Include="AprsNet.Packets" Version="0.6.0-alpha.1" />
    <PackageVersion Include="AprsNet.Symbols" Version="0.6.0-alpha.1" />
  </ItemGroup>
  <ItemGroup Label="Build">
    <PackageVersion Include="MinVer" Version="8.0.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
  </ItemGroup>
  <ItemGroup Label="Runtime">
    <PackageVersion Include="Avalonia" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Browser" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageVersion Include="Velopack" Version="1.2.161" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="Dock.Avalonia" Version="12.1.0.12" />
    <PackageVersion Include="Dock.Avalonia.Themes.Fluent" Version="12.1.0.12" />
    <PackageVersion Include="Dock.Model.Mvvm" Version="12.1.0.12" />
    <PackageVersion Include="Dock.Serializer.SystemTextJson" Version="12.1.0.12" />
    <PackageVersion Include="Mapsui" Version="5.1.0" />
    <PackageVersion Include="Mapsui.Rendering.Skia" Version="5.1.0" />
    <PackageVersion Include="Mapsui.Tiling" Version="5.1.0" />
    <PackageVersion Include="MessageFormat" Version="8.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup Label="Telemetry">
    <PackageVersion Include="Serilog" Version="4.4.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageVersion Include="OpenTelemetry" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.InMemory" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.20.1" />
  </ItemGroup>
  <ItemGroup Label="Tests">
    <PackageVersion Include="Avalonia.Headless.XUnit" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Skia" Version="12.1.4" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="GitHubActionsTestLogger" Version="3.0.5" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit.v3.mtp-off" Version="4.0.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>
</Project>

<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Only nuget.org, and every package must come from it (package source mapping). This ignores machine-wide
       sources and blocks dependency confusion from any other feed. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>

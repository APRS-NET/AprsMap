<Project>
  <Import Project="build/Components.targets" />

  <!-- Licence per project (LICENSING.md). A project opts into MIT with <ZedMapLicense>MIT</ZedMapLicense>; everything
       else is the repository default. -->
  <PropertyGroup>
    <ZedMapLicense Condition="'$(ZedMapLicense)' == ''">AGPL-3.0-only</ZedMapLicense>
    <PackageLicenseExpression>$(ZedMapLicense)</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup Condition="'$(ZedMapIsShipped)' == 'true' And '$(ZedMapLicense)' == 'MIT'">
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.Engine.txt" />
  </ItemGroup>

  <ItemGroup Condition="'$(ZedMapIsShipped)' == 'true' And '$(ZedMapUsesAvalonia)' == 'true'">
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.UI.txt" />
  </ItemGroup>

  <!-- Expose a project's licence to other projects. -->
  <Target Name="ZedMapGetLicense" Returns="$(ZedMapLicense)" />

  <!-- MIT code must never depend on AGPL code, or it would stop being MIT in practice. Fails the build when an MIT
       project references a project with any other licence. -->
  <Target
    Name="ZedMapCheckLicenceBoundary"
    BeforeTargets="ResolveProjectReferences"
    Condition="'$(ZedMapLicense)' == 'MIT' And '@(ProjectReference)' != ''"
  >
    <MSBuild Projects="@(ProjectReference)" Targets="ZedMapGetLicense" BuildInParallel="true">
      <Output TaskParameter="TargetOutputs" ItemName="_ZedMapReferenceLicence" />
    </MSBuild>
    <Error
      Condition="'%(_ZedMapReferenceLicence.Identity)' != 'MIT'"
      Text="$(MSBuildProjectName) is MIT and must not reference %(_ZedMapReferenceLicence.MSBuildSourceProjectFile), which is %(_ZedMapReferenceLicence.Identity). See LICENSING.md."
    />
  </Target>
</Project>
